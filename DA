-- Get core services and player references
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Define key objects
local batteryAttachment = workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateAttachment = workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment") -- This is the Battery Deposit point
local grabRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

-- Teleport helper function
local function teleportTo(target)
    humanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0) -- Prevent getting stuck in ground
    task.wait(1) -- Let character stabilize after teleport
end

-- Main auto sequence loop
while true do
    -- Step 1: Teleport to battery and grab it
    teleportTo(batteryAttachment)
    grabRemote:FireServer(batteryAttachment)
    task.wait(2) -- Wait for grab to complete server-side

    -- Step 2: Immediately teleport to deposit point and use battery
    teleportTo(crateAttachment)
    useRemote:FireServer(crateAttachment)
    task.wait(3) -- Wait for deposit to process

    -- Optional: Wait before restarting the cycle
    task.wait(4)
end
