-- ==========================================
-- BATTERY AUTOMATION HUB - MINIMAL VERSION
-- ==========================================

print("[INIT] Script starting...")

-- Defensive wrapper around entire script
local function safeExecute()
    print("[INIT] Entering safe execute...")
    
    local DEBUG_MODE = true
    
    local function debugLog(msg)
        if DEBUG_MODE then print("[DEBUG] " .. tostring(msg)) end
    end
    
    local function errorLog(msg)
        print("[ERROR] " .. tostring(msg))
        warn("[ERROR] " .. tostring(msg))
    end
    
    -- Test game services exist
    debugLog("Testing game services...")
    local game_obj = game
    if not game_obj then
        errorLog("game object is nil!")
        return
    end
    
    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer
    if not localPlayer then
        errorLog("LocalPlayer not found - waiting for it...")
        localPlayer = players:WaitForChild("LocalPlayer", 5)
    end
    
    if not localPlayer then
        errorLog("FATAL: LocalPlayer still unavailable")
        return
    end
    
    debugLog("✅ LocalPlayer found")
    
    -- Create a simple in-game UI using Roblox GUI
    debugLog("Creating GUI...")
    
    local playerGui = localPlayer:WaitForChild("PlayerGui", 5)
    if not playerGui then
        errorLog("PlayerGui not found")
        return
    end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "BatteryAutomationGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui
    
    -- Create title label
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(0, 300, 0, 50)
    titleLabel.Position = UDim2.new(0, 10, 0, 10)
    titleLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    titleLabel.BackgroundTransparency = 0.3
    titleLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    titleLabel.TextSize = 18
    titleLabel.Text = "Battery Automation Hub"
    titleLabel.Parent = screenGui
    
    -- Create status label
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(0, 300, 0, 200)
    statusLabel.Position = UDim2.new(0, 10, 0, 70)
    statusLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    statusLabel.BackgroundTransparency = 0.3
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    statusLabel.TextSize = 14
    statusLabel.Text = "✅ GUI Loaded\n\nSearching for game objects..."
    statusLabel.TextWrapped = true
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.TextYAlignment = Enum.TextYAlignment.Top
    statusLabel.Parent = screenGui
    
    debugLog("✅ GUI Created")
    
    -- Search for game objects
    local workspace = game:GetService("Workspace")
    local replicatedStorage = game:GetService("ReplicatedStorage")
    
    local remotes = replicatedStorage:FindFirstChild("Remotes")
    local terrain = workspace:FindFirstChild("Terrain")
    local batteryAttachment = nil
    local eggCrateAttachment = nil
    
    if terrain then
        batteryAttachment = terrain:FindFirstChild("BatterySpawnAttachment")
        eggCrateAttachment = terrain:FindFirstChild("EggCrateSpawnAttachment")
    end
    
    -- Update status
    local statusText = "✅ GUI Loaded\n"
    statusText = statusText .. (remotes and "✅ Remotes found\n" or "❌ Remotes not found\n")
    statusText = statusText .. (terrain and "✅ Terrain found\n" or "❌ Terrain not found\n")
    statusText = statusText .. (batteryAttachment and "✅ Battery Attachment found\n" or "❌ Battery Attachment not found\n")
    statusText = statusText .. (eggCrateAttachment and "✅ Crate Attachment found\n" or "❌ Crate Attachment not found\n")
    
    statusLabel.Text = statusText
    
    debugLog("✅ Script initialization complete")
    
    -- Global variables for automation
    _G.AutoFarm = false
    _G.AutoTeleport = false
    _G.FarmDelay = 0.3
    
    -- Create a simple toggle button
    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Size = UDim2.new(0, 300, 0, 40)
    toggleButton.Position = UDim2.new(0, 10, 0, 280)
    toggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextSize = 16
    toggleButton.Text = "Toggle Auto Farm (OFF)"
    toggleButton.Parent = screenGui
    
    local farmActive = false
    
    toggleButton.MouseButton1Click:Connect(function()
        farmActive = not farmActive
        toggleButton.Text = farmActive and "Toggle Auto Farm (ON)" or "Toggle Auto Farm (OFF)"
        toggleButton.BackgroundColor3 = farmActive and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(30, 30, 30)
        
        if farmActive and remotes and batteryAttachment and eggCrateAttachment then
            debugLog("Auto farm started")
            task.spawn(function()
                while farmActive do
                    local grabRemote = remotes:FindFirstChild("GrabBatteryRemote")
                    local useRemote = remotes:FindFirstChild("UseBatteryOnCrateRemote")
                    
                    if grabRemote then
                        pcall(function() grabRemote:FireServer(batteryAttachment) end)
                    end
                    task.wait(_G.FarmDelay)
                    
                    if useRemote then
                        pcall(function() useRemote:FireServer(eggCrateAttachment) end)
                    end
                    task.wait(_G.FarmDelay)
                end
            end)
        end
    end)
    
    debugLog("✅ All systems ready")
end

-- Execute with error handling
local success, err = pcall(safeExecute)
if not success then
    print("[FATAL ERROR] " .. tostring(err))
    warn("[FATAL ERROR] " .. tostring(err))
    print(debug.traceback())
end

print("[INIT] Script execution finished")
