-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Configuration
local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GrabBattery = Remotes:WaitForChild("GrabBatteryRemote")
local UseBattery = Remotes:WaitForChild("UseBatteryOnCrateRemote")

-- Target Attachments/Positions
local Terrain = Workspace:WaitForChild("Terrain")
local BatteryAttachment = Terrain:WaitForChild("BatterySpawnAttachment")
local CrateAttachment = Terrain:WaitForChild("EggCrateSpawnAttachment")

-- Helper function to safely teleport the character
local function teleportTo(targetAttachment)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if rootPart and targetAttachment then
        -- Teleport slightly above the attachment to avoid clipping
        rootPart.CFrame = targetAttachment.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.2) -- Small delay to allow physics/position to sync
        return true
    end
    return false
end

-- Main Automation Function
local function startAutoFarm()
    while true do
        -- 1. Teleport to Battery and Interact
        if teleportTo(BatteryAttachment) then
            GrabBattery:FireServer(BatteryAttachment)
            task.wait(0.5) -- Wait for server to process the grab
        end

        -- 2. Teleport to Battery Deposit (Crate) and Interact
        if teleportTo(CrateAttachment) then
            UseBattery:FireServer(CrateAttachment)
            task.wait(0.2) -- Wait for server to process the deposit
            
            -- 3. Lock position at the deposit for 3 seconds
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                -- Anchor the root part to lock position
                rootPart.Anchored = true
                task.wait(3)
                rootPart.Anchored = false
            end
        end
        
        task.wait(0.5) -- Small cooldown before restarting the loop
    end
end

-- Start the script
task.spawn(startAutoFarm)
