-- Wrap everything in a protected call so you can see the error in the Developer Console (F9) if it fails
local success, err = pcall(function()
    
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

    -- Create Window
    local Window = Rayfield:CreateWindow({
        Name = "Battery Automation Hub",
        Icon = "rbxassetid://0", -- Explicitly formatted string icon to prevent library script errors
        LoadingTitle = "Loading Script Suite...",
        LoadingSubtitle = "Ready",
        ConfigurationSaving = {
            Enabled = false
        },
        Discord = {
            Enabled = false
        },
        KeySystem = false
    })

    -- Shared Global Variables
    local _G = _G or {}
    _G.AutoFarm = false
    _G.AutoTeleport = false
    _G.FarmDelay = 0.3

    -- Services & Safeguards
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local workspace = game:GetService("Workspace")
    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer

    -- Check for Remotes Folder (Using a fallback in case folders are structured differently)
    local remotes = replicatedStorage:WaitForChild("Remotes", 5)
    if not remotes then 
        warn("Could not find 'Remotes' folder in ReplicatedStorage!")
        return 
    end

    local grabBatteryRemote = remotes:WaitForChild("GrabBatteryRemote", 5)
    local useBatteryRemote = remotes:WaitForChild("UseBatteryOnCrateRemote", 5)

    -- Check for Workspace Items
    local terrain = workspace:WaitForChild("Terrain", 5)
    local batteryAttachment = terrain and terrain:WaitForChild("BatterySpawnAttachment", 5)
    local eggCrateAttachment = terrain and terrain:WaitForChild("EggCrateSpawnAttachment", 5)

    -- ==========================================
    -- TAB 1: AUTOMATION
    -- ==========================================
    local AutomationTab = Window:CreateTab("Automation", "rbxassetid://0") 
    AutomationTab:CreateSection("Battery Loops")

    -- Toggle 1: Auto Farm Loop
    local FarmToggle = AutomationTab:CreateToggle({
        Name = "Auto Grab & Use Battery",
        CurrentValue = false,
        Flag = "AutoFarmFlag",
        Callback = function(Value)
            _G.AutoFarm = Value
            
            if Value then
                task.spawn(function()
                    while _G.AutoFarm do
                        -- 1. Grab Battery
                        if grabBatteryRemote and batteryAttachment then
                            local grabArgs = { batteryAttachment }
                            grabBatteryRemote:FireServer(unpack(grabArgs))
                        end
                        
                        task.wait(_G.FarmDelay)
                        
                        -- 2. Use Battery
                        if useBatteryRemote and eggCrateAttachment then
                            local useArgs = { eggCrateAttachment }
                            useBatteryRemote:FireServer(unpack(useArgs))
                        end
                        
                        task.wait(_G.FarmDelay)
                    end
                end)
            end
        end,
    })

    -- Slider to control loop speeds
    local DelaySlider = AutomationTab:CreateSlider({
        Name = "Action Speed Delay",
        Range = {0.1, 2},
        Increment = 0.1,
        Suffix = "s",
        CurrentValue = 0.3,
        Flag = "DelaySliderFlag",
        Callback = function(Value)
            _G.FarmDelay = Value
        end,
    })

    -- ==========================================
    -- TAB 2: TELEPORTS
    -- ==========================================
    local TeleportTab = Window:CreateTab("Teleports", "rbxassetid://0")
    TeleportTab:CreateSection("Movement Toggles")

    -- Toggle 2: Auto Teleport Loop
    local TeleportToggle = TeleportTab:CreateToggle({
        Name = "Auto Teleport to Crate (Loop)",
        CurrentValue = false,
        Flag = "TeleportFlag",
        Callback = function(Value)
            _G.AutoTeleport = Value
            
            if Value then
                task.spawn(function()
                    while _G.AutoTeleport do
                        local character = localPlayer.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")
                        
                        if hrp and eggCrateAttachment then
                            hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
                        end
                        
                        task.wait(1)
                    end
                end)
            end
        end,
    })

    TeleportTab:CreateSection("Instant Waypoints")

    -- Teleport Buttons
    TeleportTab:CreateButton({
        Name = "Teleport to Crate (Once)",
        Callback = function()
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp and eggCrateAttachment then
                hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
            end
        end,
    })

    TeleportTab:CreateButton({
        Name = "Teleport to Battery Spawn (Once)",
        Callback = function()
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp and batteryAttachment then
                hrp.CFrame = CFrame.new(batteryAttachment.WorldPosition + Vector3.new(0, 3, 0))
            end
        end,
    })

end)

-- Output the error if it fails to execute
if not success then
    warn("Script failure reason: " .. tostring(err))
end
