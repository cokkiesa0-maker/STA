-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Targets (confirm these paths are 100% correct!)
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local lockCFrame = crateDeposit.WorldCFrame + Vector3.new(0, 1.5, 0)
local batteryCFrame = batterySpawn.WorldCFrame + Vector3.new(0, 2, 0) -- Explicit battery position

-- Remotes
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Lock connection variable
local lockConnection = nil

-- FULLY disable position lock
local function stopAllLocks()
    if lockConnection then
        lockConnection:Disconnect()
        lockConnection = nil
    end
    -- Force enable movement
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
    humanoid.AutoRotate = true
end

-- Lock to deposit
local function lockToDeposit()
    stopAllLocks() -- Clear any existing locks first
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false
    
    lockConnection = RunService.Heartbeat:Connect(function()
        if humanoidRootPart then
            humanoidRootPart.CFrame = lockCFrame
        end
    end)
end

-- Force teleport to battery
local function teleportToBattery()
    stopAllLocks() -- Critical: Turn off lock BEFORE teleporting
    
    -- Force move the character multiple times to override any stuck position
    for i = 1, 3 do
        humanoidRootPart.CFrame = batteryCFrame
        task.wait(0.1) -- Small wait between each push
    end
    
    task.wait(2) -- Longer wait to ensure character stays there
    grabRemote:FireServer(batterySpawn)
    task.wait(1)
end

-- Collect drops
local function collectDrops()
    task.wait(1)
    for _, part in ipairs(Workspace:GetPartsInRadius(lockCFrame.Position, 10)) do
        if part:IsA("BasePart") and part.Name:find("Drop") then
            stopAllLocks()
            humanoidRootPart.CFrame = part.WorldCFrame + Vector3.new(0, 1, 0)
            task.wait(0.5)
            lockToDeposit()
        end
    end
end

-- Main cycle
while true do
    print("Going to get battery...") -- For debugging - check output window
    teleportToBattery()
    
    print("Returning to deposit...")
    humanoidRootPart.CFrame = lockCFrame
    task.wait(1)
    lockToDeposit()
    
    print("Using battery...")
    useRemote:FireServer(crateDeposit)
    task.wait(1)
    dropsRemote:FireServer(Instance.new("Attachment"))
    collectDrops()
    
    task.wait(3) -- Adjust wait time between cycles
end
