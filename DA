-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Configuration
local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GrabBattery = Remotes:WaitForChild("GrabBatteryRemote")
local UseBattery = Remotes:WaitForChild("UseBatteryOnCrateRemote")
local Terrain = Workspace:WaitForChild("Terrain")

-- Scan Function
local function scanForTargets()
    print("Scanning for Battery and Deposit...")
    
    -- 5-second timeout to look for the attachments
    local battery = Terrain:WaitForChild("BatterySpawnAttachment", 5)
    local deposit = Terrain:WaitForChild("EggCrateSpawnAttachment", 5)
    
    if battery and deposit then
        print("Scan successful! Both targets found.")
        return battery, deposit
    else
        warn("Scan failed. One or both targets are missing from Workspace.")
        return nil, nil
    end
end

-- Teleport Helper
local function teleportTo(targetAttachment)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if rootPart and targetAttachment then
        rootPart.CFrame = targetAttachment.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.2)
        return true
    end
    return false
end

-- Main Automation
local function startAutoFarm()
    -- Perform initial scan
    local battery, deposit = scanForTargets()
    if not (battery and deposit) then return end

    while true do
        -- 1. Teleport to Battery
        if teleportTo(battery) then
            GrabBattery:FireServer(battery)
            task.wait(0.5)
        end

        -- 2. Teleport to Deposit
        if teleportTo(deposit) then
            UseBattery:FireServer(deposit)
            task.wait(0.2)
            
            -- 3. Lock Position for 3 seconds
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.Anchored = true
                task.wait(3)
                rootPart.Anchored = false
            end
        end
        
        task.wait(0.5)
    end
end

task.spawn(startAutoFarm)
