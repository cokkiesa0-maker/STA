-- [[ CONFIGURATION ]] --
local INTERACT_DELAY = 0.8 
local DETECT_RADIUS = 20 -- Slightly increased to account for larger dragon hitboxes
local POST_DEPOSIT_WAIT = 3 
local MOUNT_KEY = Enum.KeyCode.R 

-- [[ SERVICES ]] --
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- State tracking
local CURRENT_STATE = "HUNTING"

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    HumanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
    Humanoid = newCharacter:WaitForChild("Humanoid")
    CURRENT_STATE = "HUNTING" 
end)

-- [[ DRAGON MOUNT CHECKER & GETTER ]] --
local function getDragonAndSeat()
    if not Humanoid then return nil, nil end
    
    -- Check if the player is currently sitting in a vehicle/saddle seat
    if Humanoid.SeatPart and Humanoid.SeatPart:IsA("Seat") then
        local seat = Humanoid.SeatPart
        -- Walk up the hierarchy to find the dragon model
        local current = seat.Parent
        while current and current ~= workspace do
            if current:IsA("Model") and (string.find(string.lower(current.Name), "dragon") or current:FindFirstChild("Humanoid")) then
                return current, seat
            end
            current = current.Parent
        end
        return seat.Parent, seat -- Fallback to immediate parent if specific name isn't found
    end
    return nil, nil
end

local function ensureMounted()
    local dragon, _ = getDragonAndSeat()
    if dragon then return true end -- Already safely riding
    
    print("[Mount Manager] On foot. Attempting to mount dragon...")
    VirtualInputManager:SendKeyEvent(true, MOUNT_KEY, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, MOUNT_KEY, false, game)
    task.wait(1.5) -- Wait for mount animation to complete
    
    dragon, _ = getDragonAndSeat()
    return dragon ~= nil
end

-- [[ FIXED TELEPORT (NO DISMOUNT) ]] --
local function safeTeleport(targetCFrame)
    if not HumanoidRootPart or not Humanoid then return end
    
    -- Make sure we are mounted before doing anything
    ensureMounted()
    
    local dragon, seat = getDragonAndSeat()
    local offset = CFrame.new(0, 5, 0) -- Higher offset to stop dragon from getting stuck in the ground
    
    if dragon then
        -- [[ DRAGON MOVEMENT MODE ]] --
        -- If we are riding, do NOT touch Humanoid states or change individual velocities.
        -- Instead, teleport the entire dragon model as one cohesive unit.
        print("[Teleport] Moving dragon and player together...")
        
        local dragonRoot = dragon.PrimaryPart or seat or dragon:FindFirstChildWithClass("BasePart")
        if dragonRoot then
            dragonRoot.AssemblyLinearVelocity = Vector3.new(0,0,0)
            dragonRoot.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
        
        dragon:PivotTo(targetCFrame * offset)
        task.wait(0.2)
        
        if dragonRoot then
            dragonRoot.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
    else
        -- [[ FALLBACK FOOT MOVEMENT MODE ]] --
        -- Used only if your dragon isn't spawned or fails to mount
        print("[Teleport] Fallback player-only teleport...")
        HumanoidRootPart.Anchored = false 
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 2, 0)
        
        task.wait(0.1)
        HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    
    task.wait(0.3) -- Server sync pause
end

-- [[ AUTOMATED INTERACTION ]] --
local function interact()
    local foundPrompt = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") and (HumanoidRootPart.Position - parent.Position).Magnitude <= DETECT_RADIUS then
                obj:InputHoldBegin()
                task.wait(obj.HoldDuration + 0.1)
                obj:InputHoldEnd()
                foundPrompt = true
                break
            end
        end
    end
    
    if not foundPrompt then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
    task.wait(INTERACT_DELAY)
end

-- [[ WORKSPACE SCANNER ]] --
local function scanWorkspace()
    local batteries = {}
    local deposits = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            
            -- Make sure script doesn't try to target parts belonging to your own dragon/character
            if not obj:IsDescendantOf(Character) and not Players:GetPlayerFromCharacter(obj.Parent) then
                local dragon, _ = getDragonAndSeat()
                if not (dragon and obj:IsDescendantOf(dragon)) then
                    
                    if string.find(lowerName, "battery") and not string.find(lowerName, "deposit") and not string.find(lowerName, "zone") then
                        table.insert(batteries, obj)
                    elseif string.find(lowerName, "deposit") or string.find(lowerName, "ufo") or string.find(lowerName, "ship") or string.find(lowerName, "generator") then
                        table.insert(deposits, obj)
                    end
                    
                end
            end
        end
    end
    return batteries, deposits
end

-- [[ CORE REPEATING LOOP ]] --
local function run()
    print("[Script Active] Mounted teleport loops active. Dismount protections enabled.")
    
    while true do
        local batteries, deposits = scanWorkspace()
        
        -- STATE 1: Hunt for Battery
        if CURRENT_STATE == "HUNTING" then
            if #batteries > 0 then
                local targetBattery = batteries[1]
                print("State: HUNTING -> Teleporting on dragon to Battery...")
                
                safeTeleport(targetBattery.CFrame)
                interact()
                
                CURRENT_STATE = "DEPOSITING"
                print("State Shift -> DEPOSITING")
            else
                print("State: HUNTING -> Awaiting battery respawn...")
            end
            
        -- STATE 2
