-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Targets (wait for all to load first)
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local lockCFrame = crateDeposit.WorldCFrame + Vector3.new(0, 1.5, 0) -- Adjust offset if needed

-- Remotes
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Lock connection variable
local lockConnection = nil

-- Enable movement temporarily
local function enableMovement()
    if lockConnection then
        lockConnection:Disconnect()
        lockConnection = nil
    end
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
end

-- Lock position to deposit
local function lockToDeposit()
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    
    lockConnection = RunService.Heartbeat:Connect(function()
        if humanoidRootPart then
            humanoidRootPart.CFrame = lockCFrame
        end
    end)
end

-- Collect battery function
local function getBattery()
    enableMovement()
    -- Teleport to battery and wait for position to set
    humanoidRootPart.CFrame = batterySpawn.WorldCFrame + Vector3.new(0, 2, 0)
    task.wait(1.5) -- Longer wait to make sure we're there
    -- Fire remote to grab battery
    grabRemote:FireServer(batterySpawn)
    task.wait(1) -- Wait for grab to register
end

-- Collect drops near deposit
local function collectDrops()
    task.wait(1)
    for _, part in ipairs(Workspace:GetPartsInRadius(lockCFrame.Position, 10)) do
        if part:IsA("BasePart") and part.Name:find("Drop") then
            enableMovement() -- Temporarily unlock to collect
            humanoidRootPart.CFrame = part.WorldCFrame + Vector3.new(0, 1, 0)
            task.wait(0.5)
            lockToDeposit() -- Re-lock after collecting
        end
    end
end

-- Main cycle loop - keeps repeating forever
while true do
    -- Step 1: Get new battery
    getBattery()
    
    -- Step 2: Return to deposit and lock
    humanoidRootPart.CFrame = lockCFrame
    task.wait(1)
    lockToDeposit()
    
    -- Step 3: Use battery and collect drops
    useRemote:FireServer(crateDeposit)
    task.wait(1)
    dropsRemote:FireServer(Instance.new("Attachment"))
    collectDrops()
    
    -- Wait before getting next battery (adjust time as needed)
    task.wait(2)
end
