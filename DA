-- [[ CONFIGURATION ]] --
local TWEEN_SPEED = 45 -- Studs per second. Lower is safer/more natural; higher is faster.
local INTERACT_DELAY = 0.8 
local DETECT_RADIUS = 15 
local POST_DEPOSIT_WAIT = 3 -- Strict 3-second lock time

-- [[ SERVICES ]] --
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- State tracking
local CURRENT_STATE = "HUNTING"

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    HumanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
    CURRENT_STATE = "HUNTING" 
end)

-- [[ TWEEN MOVEMENT ]] --
local function safeTween(targetCFrame)
    if not HumanoidRootPart then return end
    
    -- Ensure player is unanchored before trying to move
    HumanoidRootPart.Anchored = false 
    HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    
    -- Calculate duration based on distance to keep speed constant
    local distance = (HumanoidRootPart.Position - targetCFrame.Position).Magnitude
    local duration = distance / TWEEN_SPEED
    
    -- Smooth linear movement profile
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetCFrame * CFrame.new(0, 2, 0)})
    
    tween:Play()
    tween.Completed:Wait() -- Wait until character completely arrives
    task.wait(0.2) 
end

-- [[ INTERACTION ]] --
local function interact()
    local foundPrompt = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") and (HumanoidRootPart.Position - parent.Position).Magnitude <= DETECT_RADIUS then
                obj:InputHoldBegin()
                task.wait(obj.HoldDuration + 0.1)
                obj:InputHoldEnd()
                foundPrompt = true
                break
            end
        end
    end
    
    if not foundPrompt then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
    task.wait(INTERACT_DELAY)
end

-- [[ STRICT OBJECT FILTERING ]] --
local function scanWorkspace()
    local batteries = {}
    local deposits = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            
            if not obj:IsDescendantOf(Character) and not Players:GetPlayerFromCharacter(obj.Parent) then
                if string.find(lowerName, "battery") and not string.find(lowerName, "deposit") and not string.find(lowerName, "zone") then
                    table.insert(batteries, obj)
                elseif string.find(lowerName, "deposit") or string.find(lowerName, "ufo") or string.find(lowerName, "ship") or string.find(lowerName, "generator") then
                    table.insert(deposits, obj)
                end
            end
        end
    end
    return batteries, deposits
end

-- [[ MAIN EXECUTION ]] --
local function run()
    print("[Script Active] Tween configuration active. Hunting mode initiated.")
    
    while true do
        local batteries, deposits = scanWorkspace()
        
        -- STATE 1: Look ONLY for a battery
        if CURRENT_STATE == "HUNTING" then
            if #batteries > 0 then
                local targetBattery = batteries[1]
                print("State: HUNTING -> Tweening to Battery...")
                
                safeTween(targetBattery.CFrame)
                interact()
                
                CURRENT_STATE = "DEPOSITING"
                print("State Changed -> DEPOSITING")
            else
                print("State: HUNTING -> Waiting for a battery to spawn...")
            end
            
        -- STATE 2: Look ONLY for a deposit station
        elseif CURRENT_STATE == "DEPOSITING" then
            if #deposits > 0 then
                local targetDeposit = deposits[math.random(1, #deposits)]
                print("State: DEPOSITING -> Tweening to Station...")
                
                safeTween(targetDeposit.CFrame)
                interact()
                
                -- [[ LOCK POSITION AFTER DEPOSIT ]] --
                print("Deposit finished! Locking position for " .. POST_DEPOSIT_WAIT .. " seconds.")
                HumanoidRootPart.Anchored = true
                task.wait(POST_DEPOSIT_WAIT)
                HumanoidRootPart.Anchored = false
                print("Unanchored. Resuming.")
                
                CURRENT_STATE = "HUNTING"
                print("State Changed -> HUNTING")
            else
                print("State: DEPOSITING -> No deposit stations found in workspace!")
                CURRENT_STATE = "HUNTING" 
            end
        end
        
        task.wait(0.5)
    end
end

pcall(run)
