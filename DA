print("TEST_START")

local success, err = pcall(function()
    print("INSIDE_PCALL")
    
    local game_service = game
    print("GOT_GAME: " .. tostring(game_service ~= nil))
    
    local Players = game:GetService("Players")
    print("GOT_PLAYERS: " .. tostring(Players ~= nil))
    
    local LP = Players.LocalPlayer
    print("GOT_LP: " .. tostring(LP ~= nil))
    
    if not LP then
        print("WAITING_FOR_LP")
        LP = Players:WaitForChild("LocalPlayer", 5)
    end
    
    print("LP_FINAL: " .. tostring(LP ~= nil))
    
    if LP then
        local PG = LP:WaitForChild("PlayerGui", 5)
        print("GOT_PLAYERGUI: " .. tostring(PG ~= nil))
        
        if PG then
            local ScreenGui = Instance.new("ScreenGui")
            ScreenGui.Parent = PG
            print("SCREENGUI_CREATED")
            
            local Label = Instance.new("TextLabel")
            Label.Text = "TEST_SUCCESS"
            Label.Parent = ScreenGui
            print("LABEL_CREATED")
        end
    end
end)

print("PCALL_SUCCESS: " .. tostring(success))
if not success then
    print("ERROR: " .. tostring(err))
    print("TRACEBACK:")
    print(debug.traceback())
end

print("TEST_END")
