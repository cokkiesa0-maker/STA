-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Remotes & Attachments (with extra checks)
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

local batteryAttach = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateAttach = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

-- Settings
local TELEPORT_OFFSET = Vector3.new(0, 2, 0)
local ACTION_DELAY = 1.5
local LOOP_DELAY = 3

-- Safe teleport function
local function safeTeleport(target)
    if not humanoidRootPart or humanoid.Health <= 0 then return false end
    humanoidRootPart.CFrame = target.WorldCFrame + TELEPORT_OFFSET
    wait(ACTION_DELAY) -- Longer wait to ensure teleport completes
    return true
end

-- Main loop
while true do
    -- Step 1: Get battery
    print("Teleporting to battery...")
    if safeTeleport(batteryAttach) then
        grabRemote:FireServer(batteryAttach)
        print("Grabbed battery!")
    end

    -- Step 2: Go to deposit (separate wait to make sure it moves)
    wait(ACTION_DELAY)
    print("Teleporting to crate...")
    if safeTeleport(crateAttach) then
        useRemote:FireServer(crateAttach) -- Only send crate if that's what the remote needs
        print("Deposited battery!")
    end

    wait(LOOP_DELAY) -- Wait before restarting
end

