-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Configuration
local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GrabBattery = Remotes:WaitForChild("GrabBatteryRemote")
local UseBattery = Remotes:WaitForChild("UseBatteryOnCrateRemote")
local Terrain = Workspace:WaitForChild("Terrain")

-- Wait for Map and Assets to Load Completely
local function waitForGameToLoad()
    print("[Loader] Waiting for game instance and character to load...")
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    character:WaitForChild("HumanoidRootPart")
    character:WaitForChild("Humanoid")

    local battery = nil
    local deposit = nil
    local retries = 0
    local maxRetries = 30

    while not (battery and deposit) and retries < maxRetries do
        battery = Terrain:FindFirstChild("BatterySpawnAttachment")
        deposit = Terrain:FindFirstChild("EggCrateSpawnAttachment")
        
        if battery and deposit then break end
        retries = retries + 1
        task.wait(1)
    end

    if battery and deposit then
        print("[Loader] Setup complete. Map targets verified.")
        return battery, deposit
    else
        warn("[Loader] Failed to find target attachments within timeframe.")
        return nil, nil
    end
end

-- Physics-Based Movement Function (Avoids CFrame)
local function navigateToTarget(targetAttachment)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if humanoid and rootPart and targetAttachment then
        -- Optional: Slightly increase speed if the game allows configuration modifying WalkSpeed
        -- humanoid.WalkSpeed = 32 

        -- Command the character's physics engine to navigate to the target vector position
        humanoid:MoveTo(targetAttachment.Position)
        
        -- Yield the script until the character physically arrives at the target point
        -- Includes an absolute 15-second safety timeout so the loop doesn't freeze indefinitely
        local reached = nil
        local timeout = task.delay(15, function()
            if not reached then
                humanoid:MoveTo(rootPart.Position) -- Cancel movement if stuck
            end
        end)
        
        humanoid.MoveToFinished:Wait()
        reached = true
        task.cancel(timeout)
        
        task.wait(0.2) -- Brief pause to ensure physics fully settle on the server
        return true
    end
    return false
end

-- Main Automation Loop
local function startAutoFarm()
    local battery, deposit = waitForGameToLoad()
    if not (battery and deposit) then return end

    while true do
        -- 1. Navigate to Battery & Grab
        print("[Farm] Navigating to Battery...")
        if navigateToTarget(battery) then
            GrabBattery:FireServer(battery)
            task.wait(0.5) -- Time for server verification
        end

        -- 2. Navigate to Deposit & Use
        print("[Farm] Navigating to Deposit...")
        if navigateToTarget(deposit) then
            UseBattery:FireServer(deposit)
            task.wait(0.2)
            
            -- 3. Lock Position for 3 Seconds
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                print("[Farm] Locking character at deposit...")
                rootPart.Anchored = true
                task.wait(3)
                rootPart.Anchored = false
                print("[Farm] Position unlocked.")
            end
        end
        
        task.wait(1) -- Safety cooldown between farm cycles
    end
end

task.spawn(startAutoFarm)
