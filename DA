-- Get player and humanoid root part
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Define target attachments
local batteryAttachment = workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateAttachment = workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

-- Define remotes
local grabRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

-- Function to teleport and wait for character stability
local function teleportTo(target)
    humanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0) -- Add height to avoid ground issues
    task.wait(1) -- Wait for character to settle
end

-- Auto sequence
while true do
    -- Teleport to battery and grab
    teleportTo(batteryAttachment)
    grabRemote:FireServer(batteryAttachment)
    task.wait(2) -- Wait for grab action to process

    -- Teleport to crate and deposit
    teleportTo(crateAttachment)
    useRemote:FireServer(crateAttachment)
    task.wait(3) -- Wait for deposit action to process

    -- Wait before next cycle (adjust time as needed)
    task.wait(5)
end
