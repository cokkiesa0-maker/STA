-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Targets (confirm these paths are correct!)
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local batteryCFrame = batterySpawn.WorldCFrame + Vector3.new(0, 2, 0)
local lockCFrame = crateDeposit.WorldCFrame + Vector3.new(0, 1.5, 0)

-- Remotes
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Lock connection variable
local lockConnection = nil

-- Disable all locks and enable movement
local function stopAllLocks()
    if lockConnection then
        lockConnection:Disconnect()
        lockConnection = nil
    end
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
    humanoid.AutoRotate = true
end

-- Lock position for 3 seconds
local function lockFor3Seconds()
    stopAllLocks()
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false

    lockConnection = RunService.Heartbeat:Connect(function()
        if humanoidRootPart then
            humanoidRootPart.CFrame = lockCFrame
        end
    end)

    task.delay(3, stopAllLocks)
    print("Locked at deposit for 3 seconds")
end

-- **FORCE GET BATTERY FIRST** - won't proceed until done
local function getBattery()
    print("START: Must get battery first - will not go to deposit until complete")
    stopAllLocks()

    -- Keep trying to teleport and collect battery until successful
    local batteryCollected = false
    while not batteryCollected do
        -- Force teleport to battery
        for i = 1, 5 do
            humanoidRootPart.CFrame = batteryCFrame
            task.wait(0.1)
        end
        task.wait(2) -- Make sure character is stable at battery spot

        -- Fire remote to grab battery
        grabRemote:FireServer(batterySpawn)
        print("Attempted to collect battery")
        task.wait(1)

        -- Optional: Add check here if game has a way to confirm battery was collected
        -- Example: if player.Backpack:FindFirstChild("Battery") then batteryCollected = true end
        batteryCollected = true -- Set to true for now; replace with actual check if possible
    end

    print("SUCCESS: Battery collected - now proceeding to deposit")
end

-- Collect drops
local function collectDrops()
    task.wait(1)
    for _, part in ipairs(Workspace:GetPartsInRadius(lockCFrame.Position, 10)) do
        if part:IsA("BasePart") and part.Name:find("Drop") then
            stopAllLocks()
            humanoidRootPart.CFrame = part.WorldCFrame + Vector3.new(0, 1, 0)
            task.wait(0.5)
        end
    end
end

-- Main cycle - STRICT ORDER: GET BATTERY → DEPOSIT → REPEAT
while true do
    -- Step 1: ONLY proceed to next step if battery is collected first
    getBattery()

    -- Step 2: Now go to deposit (never happens before battery is collected)
    humanoidRootPart.CFrame = lockCFrame
    task.wait(1)
    lockFor3Seconds()

    -- Step 3: Use battery and collect drops
    useRemote:FireServer(crateDeposit)
    task.wait(1)
    dropsRemote:FireServer(Instance.new("Attachment"))
    collectDrops()

    -- Small wait before next cycle
    task.wait(1)
end
