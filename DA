-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Targets (wait for them to load first!)
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local lockCFrame = crateDeposit.WorldCFrame + Vector3.new(0, 1.5, 0) -- Adjust offset here if needed

-- Remotes
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Stop previous locks if any
local lockConnection = nil

-- Function to lock position solidly
local function lockToDeposit()
    -- Disable movement completely
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    
    -- Use RunService for instant position correction
    lockConnection = RunService.Heartbeat:Connect(function()
        if humanoidRootPart then
            humanoidRootPart.CFrame = lockCFrame
        end
    end)
end

-- Function to collect battery
local function getBattery()
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
    humanoidRootPart.CFrame = batterySpawn.WorldCFrame + Vector3.new(0, 2, 0)
    task.wait(1)
    grabRemote:FireServer(batterySpawn)
    task.wait(1)
end

-- Function to collect drops
local function collectDrops()
    task.wait(1)
    for _, part in ipairs(Workspace:GetPartsInRadius(lockCFrame.Position, 10)) do -- Check nearby only
        if part:IsA("BasePart") and part.Name:find("Drop") then -- Match any drop name
            humanoidRootPart.CFrame = part.WorldCFrame + Vector3.new(0, 1, 0)
            task.wait(0.5)
        end
    end
end

-- Main process (fixed order)
getBattery() -- Get battery first
lockToDeposit() -- Lock to deposit after getting battery

-- Repeat interactions
while true do
    task.wait(2)
    useRemote:FireServer(crateDeposit)
    task.wait(1)
    dropsRemote:FireServer(Instance.new("Attachment"))
    collectDrops()
end
