--// Configuration
local ESP_COLOR_BATTERY = Color3.fromRGB(0, 255, 255) -- Cyan
local ESP_COLOR_DEPOSIT = Color3.fromRGB(255, 165, 0) -- Orange

--// Services
local Terrain = workspace:WaitForChild("Terrain")
local CoreGui = game:GetService("CoreGui")

--// Targets
local Battery = Terrain:WaitForChild("BatterySpawnAttachment")
local EggCrate = Terrain:WaitForChild("EggCrateSpawnAttachment")

--// ESP Function
local function createESP(target, name, color)
    if not target then return end
    
    -- Target the parent Part if it's an attachment
    local visualTarget = target:IsA("Attachment") and target.Parent or target
    if not visualTarget:IsA("BasePart") then return end

    -- Avoid duplicate ESP
    if visualTarget:FindFirstChild("ESP_Highlight") then return end

    -- Create Visual Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.1
    highlight.Adornee = visualTarget
    highlight.Parent = visualTarget

    -- Create 2D Billboard Text Label
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = visualTarget
    billboard.Parent = CoreGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = color
    label.TextSize = 14
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = billboard
end

--// Run ESP
createESP(Battery, "🔋 Battery", ESP_COLOR_BATTERY)
createESP(EggCrate, "📥 Battery Deposit (Crate)", ESP_COLOR_DEPOSIT)
