-- [[ CONFIGURATION ]] --
local INTERACT_DELAY = 0.8 
local DETECT_RADIUS = 15 
local POST_DEPOSIT_WAIT = 3 -- Strict 3-second freeze lock
local MOUNT_KEY = Enum.KeyCode.R -- Standard mount/ride key for Dragon Adventures

-- [[ SERVICES ]] --
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- State tracking
local CURRENT_STATE = "HUNTING"

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    HumanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
    Humanoid = newCharacter:WaitForChild("Humanoid")
    CURRENT_STATE = "HUNTING" 
end)

-- [[ DRAGON MOUNT CHECKER ]] --
local function ensureMounted()
    if not Humanoid then return end
    
    -- In Roblox games like Dragon Adventures, being mounted changes your SeatState 
    -- or puts your character inside a specific platform/running state.
    if Humanoid.FloorMaterial == Enum.Material.Air and Humanoid:GetState() == Enum.HumanoidStateType.Seated then
        return -- Already riding/seated on the dragon
    end
    
    -- Alternate check: if the game welds your HumanoidRootPart to a dragon model
    local isWeldedToDragon = false
    for _, child in ipairs(HumanoidRootPart:GetChildren()) do
        if child:IsA("Weld") or child:IsA("Snap") or child:IsA("ManualWeld") then
            if child.Part1 and (string.find(string.lower(child.Part1.Name), "dragon") or string.find(string.lower(child.Part1.Name), "saddle")) then
                isWeldedToDragon = true
                break
            end
        end
    end
    
    if isWeldedToDragon then return end

    -- Force Mount if validation checks fail
    print("[Mount Manager] Character is on foot! Forcing dragon mount...")
    VirtualInputManager:SendKeyEvent(true, MOUNT_KEY, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, MOUNT_KEY, false, game)
    task.wait(1.5) -- Give the game ample time to complete the mounting animation
end

-- [[ ANTI-RUBBERBAND TELEPORT ]] --
local function safeTeleport(targetCFrame)
    if not HumanoidRootPart or not Humanoid then return end
    
    -- Ensure you are on your dragon before moving across the map
    ensureMounted()
    
    -- Force-kill character velocity and physics to prevent snap-backs
    HumanoidRootPart.Anchored = false 
    Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    -- Execute instant CFrame snap slightly above target
    HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 4, 0) -- Raised slightly higher for dragon clearance
    
    -- Post-teleport clamp to firmly establish new coordinates server-side
    task.wait(0.1)
    HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    
    task.wait(0.3) -- Synchronization window to let game server stabilize your position
end

-- [[ AUTOMATED INTERACTION ]] --
local function interact()
    local foundPrompt = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") and (HumanoidRootPart.Position - parent.Position).Magnitude <= DETECT_RADIUS then
                obj:InputHoldBegin()
                task.wait(obj.HoldDuration + 0.1)
                obj:InputHoldEnd()
                foundPrompt = true
                break
            end
        end
    end
    
    if not foundPrompt then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
    task.wait(INTERACT_DELAY)
end

-- [[ WORKSPACE SCANNER ]] --
local function scanWorkspace()
    local batteries = {}
    local deposits = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            
            if not obj:IsDescendantOf(Character) and not Players:GetPlayerFromCharacter(obj.Parent) then
                if string.find(lowerName, "battery") and not string.find(lowerName, "deposit") and not string.find(lowerName, "zone") then
                    table.insert(batteries, obj)
                elseif string.find(lowerName, "deposit") or string.find(lowerName, "ufo") or string.find(lowerName, "ship") or string.find(lowerName, "generator") then
                    table.insert(deposits, obj)
                end
            end
        end
    end
    return batteries, deposits
end

-- [[ CORE REPEATING LOOP ]] --
local function run()
    print("[Script Active] Auto-Ride Dragon validation enabled with teleport tracking.")
    
    while true do
        local batteries, deposits = scanWorkspace()
        
        -- STATE 1: Hunt for Battery
        if CURRENT_STATE == "HUNTING" then
            if #batteries > 0 then
                local targetBattery = batteries[1]
                print("State: HUNTING -> Verifying mount and teleporting to Battery...")
                
                safeTeleport(targetBattery.CFrame)
                interact()
                
                CURRENT_STATE = "DEPOSITING"
                print("State Shift -> DEPOSITING")
            else
                print("State: HUNTING -> Awaiting battery respawn...")
            end
            
        -- STATE 2: Find Deposit Ship
        elseif CURRENT_STATE == "DEPOSITING" then
            if #deposits > 0 then
                local targetDeposit = deposits[math.random(1, #deposits)]
                print("State: DEPOSITING -> Verifying mount and teleporting to Station...")
                
                safeTeleport(targetDeposit.CFrame)
                interact()
                
                -- [[ POST-DEPOSIT ANCHOR LOCK ]] --
                print("Drop-off finished! Anchoring dragon and character for " .. POST_DEPOSIT_WAIT .. " seconds.")
                HumanoidRootPart.Anchored = true
                task.wait(POST_DEPOSIT_WAIT)
                HumanoidRootPart.Anchored = false
                print("Character unanchored successfully.")
                
                CURRENT_STATE = "HUNTING"
                print("State Shift -> HUNTING")
            else
                print("State: DEPOSITING -> No valid targets found. Resetting state.")
                CURRENT_STATE = "HUNTING" 
            end
        end
        
        task.wait(0.5)
    end
end

pcall(run)
