-- Get core services and player references
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Store confirmed locations (initially nil until detected)
local confirmedBatterySpawn = nil
local confirmedDepositLocation = nil

-- Helper: Check if player has battery (adjust to match your game!)
local function hasBattery()
    return player.Backpack:FindFirstChild("Battery") or character:FindFirstChild("Battery")
end

-- Helper: Scan and confirm battery spawn location + availability
local function findAndValidateBatterySpawn()
    -- Look for the spawn area first, then check for battery presence
    local terrainFolder = workspace:FindFirstChild("Terrain")
    if not terrainFolder then return nil end

    local attachment = terrainFolder:FindFirstChild("BatterySpawnAttachment")
    if not attachment then return nil end

    -- Scan for actual battery at the attachment's location
    local scanArea = attachment.CFrame
    local nearbyBatteries = workspace:GetPartBoundsInBox(scanArea, Vector3.new(4, 4, 4))
    for _, obj in ipairs(nearbyBatteries) do
        if obj.Name == "Battery" then
            return attachment.CFrame -- Return exact confirmed position
        end
    end
    return nil
end

-- Helper: Scan and confirm battery deposit location + readiness
local function findAndValidateDeposit()
    -- First locate the deposit structure, then confirm it's ready
    local terrainFolder = workspace:FindFirstChild("Terrain")
    if not terrainFolder then return nil end

    local attachment = terrainFolder:FindFirstChild("EggCrateSpawnAttachment")
    if not attachment then return nil end

    -- Scan for valid deposit target and check if it needs a battery
    local scanArea = attachment.CFrame
    local nearbyCrates = workspace:GetPartBoundsInBox(scanArea, Vector3.new(4, 4, 4))
    for _, obj in ipairs(nearbyCrates) do
        if obj.Name == "EggCrate" and obj:GetAttribute("NeedsBattery") == true then
            return attachment.CFrame -- Return exact confirmed position
        end
    end
    return nil
end

-- Helper: Teleport only to confirmed valid locations
local function teleportTo(confirmedLocation)
    if confirmedLocation then
        humanoidRootPart.CFrame = confirmedLocation + Vector3.new(0, 2, 0)
        print("Teleported to confirmed location!")
        task.wait(0.75)
    else
        print("No valid location to teleport to yet...")
    end
end

-- Main loop: First detect locations, then act
while true do
    -- Step 1: Always update confirmed locations first
    confirmedBatterySpawn = findAndValidateBatterySpawn()
    confirmedDepositLocation = findAndValidateDeposit()

    -- Step 2: Handle battery collection if no battery is held
    while not hasBattery() do
        if confirmedBatterySpawn then
            teleportTo(confirmedBatterySpawn)
            ReplicatedStorage.Remotes.GrabBatteryRemote:FireServer(workspace.Terrain.BatterySpawnAttachment)
        end
        task.wait(1.5)
        -- Refresh location check each cycle
        confirmedBatterySpawn = findAndValidateBatterySpawn()
    end

    -- Step 3: Handle deposit once battery is held
    while hasBattery() do
        if confirmedDepositLocation then
            teleportTo(confirmedDepositLocation)
            ReplicatedStorage.Remotes.UseBatteryOnCrateRemote:FireServer(workspace.Terrain.EggCrateSpawnAttachment)
        end
        task.wait(1.5)
        -- Refresh location check each cycle
        confirmedDepositLocation = findAndValidateDeposit()
    end

    -- Short pause before re-scanning everything
    task.wait(2)
end
