-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- **CONFIRM THESE PATHS IN EXPLORER FIRST!**
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

-- **CONFIRM REMOTE NAMES ARE EXACT!**
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Force move character to a position
local function moveTo(pos)
    humanoid.WalkSpeed = 16
    humanoidRootPart.CFrame = pos + Vector3.new(0, 2, 0) -- Add height to avoid issues
    task.wait(2) -- Wait for server to register position
end

-- **FIXED: Test remotes with/without arguments**
local function collectBattery()
    print("Moving to battery...")
    moveTo(batterySpawn.WorldCFrame.Position)
    
    print("Trying to grab battery (with and without arguments)...")
    -- Try both ways - some remotes don't need arguments
    grabRemote:FireServer() 
    task.wait(0.5)
    grabRemote:FireServer(batterySpawn)
    task.wait(1)
end

local function depositBattery()
    print("Moving to deposit...")
    moveTo(crateDeposit.WorldCFrame.Position)
    
    print("Trying to deposit battery (with and without arguments)...")
    -- Try both ways for deposit too
    useRemote:FireServer()
    task.wait(0.5)
    useRemote:FireServer(crateDeposit)
    task.wait(1)
    
    -- Trigger drops (try with/without attachment)
    dropsRemote:FireServer()
    task.wait(0.5)
    dropsRemote:FireServer(Instance.new("Attachment"))
end

-- Main loop - battery FIRST, then deposit
while true do
    collectBattery()
    depositBattery()
    task.wait(3) -- Adjust wait time as needed
end
