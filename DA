-- // Configuration
local TWEEN_SPEED = 65 -- Speed of flight/teleportation
local FLYING_HEIGHT = 15 -- Studs off the ground (helps bypass "must be flying/dragon" checks)
local LOCK_TIME = 3 -- Seconds to wait/lock position after depositing

-- // Services & Remotes
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
-- [[ NOTE: Look in ReplicatedStorage.Remotes for something named "Transform", "SpawnDragon", or "Mount" if you need to be a dragon first! ]]

local LocalPlayer = Players.LocalPlayer
local GrabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local DepositRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

local Terrain = game:GetService("Workspace"):WaitForChild("Terrain")
local BatteryAttachment = Terrain:WaitForChild("BatterySpawnAttachment")
local CrateAttachment = Terrain:WaitForChild("EggCrateSpawnAttachment")

-- // Helper Function: Simulate Dragon Flight / Tweening
local function flyTo(targetCFrame)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- Create a flight path that stays slightly above the target initially
    local flightPath = targetCFrame + Vector3.new(0, FLYING_HEIGHT, 0)
    local distance = (rootPart.Position - flightPath.Position).Magnitude
    local duration = distance / TWEEN_SPEED

    -- Tween to the sky above the target first
    local tweenSky = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = flightPath})
    tweenSky:Play()
    tweenSky.Completed:Wait()

    -- Drop down directly onto the attachment
    rootPart.CFrame = targetCFrame
    task.wait(0.2)
end

-- // Helper Function: Lock Character in Place
local function setPositionLock(state)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        rootPart.Anchored = state
    end
end

-- // Automation Loop
local function startDragonFarm()
    while true do
        -- 1. Fly to Battery
        print("[Dragon Farm] Flying to Battery...")
        flyTo(BatteryAttachment.WorldCFrame)
        task.wait(0.3)

        -- Fire the grab remote
        GrabRemote:FireServer(BatteryAttachment)
        print("[Dragon Farm] Grab Remote Fired!")
        task.wait(0.5)

        -- 2. Fly to Crate
        print("[Dragon Farm] Flying to Deposit Crate...")
        flyTo(CrateAttachment.WorldCFrame)
        task.wait(0.3)

        -- Fire the deposit remote
        DepositRemote:FireServer(CrateAttachment)
        print("[Dragon Farm] Deposit Remote Fired!")

        -- 3. Anchor, Wait, and Prevent Teleport-Back
        print("[Dragon Farm] Locking position to bypass server check...")
        setPositionLock(true)
        task.wait(LOCK_TIME)
        setPositionLock(false)

        print("[Dragon Farm] Loop finished. Waiting for respawn...")
        task.wait(2) -- Cooldown before next cycle
    end
end

-- Start
task.spawn(startDragonFarm)
