-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player & Character References
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Remote Events
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Spawn Locations
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateSpawn = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

-- Function to Teleport Safely
local function teleportTo(target)
    if humanoid.Health <= 0 then return end -- Skip if character is dead
    humanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0) -- Add height to avoid ground issues
    task.wait(1) -- Wait for character to stabilize
end

-- Function to Collect Drops
local function collectDrops()
    local drops = Workspace:FindFirstChild("Drops") -- Adjust folder name if needed
    if not drops then return end
    
    for _, drop in ipairs(drops:GetChildren()) do
        if humanoid.Health > 0 then
            teleportTo(drop)
            task.wait(0.5) -- Simulate interaction delay
            -- If drops require a remote or touch interaction, add it here
            drop:Destroy() -- Optional: Remove drop after collection
        end
    end
end

-- Main Automation Loop
while task.wait(3) do -- Repeat every 3 seconds (adjust as needed)
    if humanoid.Health <= 0 then
        character = player.CharacterAdded:Wait() -- Wait for respawn
        humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        humanoid = character:WaitForChild("Humanoid")
        task.wait(2) -- Wait for respawn to finish
    end

    -- Step 1: Teleport to Battery & Collect
    teleportTo(batterySpawn)
    grabRemote:FireServer(batterySpawn)
    task.wait(1)

    -- Step 2: Teleport to Crate & Use Battery
    teleportTo(crateSpawn)
    useRemote:FireServer(crateSpawn)
    task.wait(1)

    -- Step 3: Trigger Drops & Collect Them
    dropsRemote:FireServer(Instance.new("Attachment"))
    task.wait(1)
    collectDrops()
end
