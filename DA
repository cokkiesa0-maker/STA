-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player & Character
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Remotes & Locations
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateSpawn = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local batteryInventoryCheck = player:WaitForChild("Inventory"):WaitForChild("Battery") -- Adjust to your inventory path

-- Teleport Function
local function teleportTo(target)
    if humanoid.Health <= 0 then return end
    humanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0)
    task.wait(1)
end

-- Collect Drops Function
local function collectDrops()
    local drops = Workspace:FindFirstChild("Drops")
    if not drops then return end
    for _, drop in ipairs(drops:GetChildren()) do
        if humanoid.Health > 0 then
            teleportTo(drop)
            task.wait(0.5)
            drop:Destroy()
        end
    end
end

-- Main Loop
while task.wait(3) do
    if humanoid.Health <= 0 then
        character = player.CharacterAdded:Wait()
        humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        humanoid = character:WaitForChild("Humanoid")
        task.wait(2)
    end

    -- Step 1: Go to battery spawn ONLY if no battery is held
    if not batteryInventoryCheck.Value then
        teleportTo(batterySpawn)
        grabRemote:FireServer(batterySpawn)
        task.wait(1.5) -- Give time for collection to register
        
        -- Wait until battery is confirmed in inventory before proceeding
        while not batteryInventoryCheck.Value do
            task.wait(0.2)
        end
    end

    -- Step 2: Now go to deposit point (only if battery is held)
    if batteryInventoryCheck.Value then
        teleportTo(crateSpawn)
        useRemote:FireServer(crateSpawn)
        task.wait(1)

        -- Step 3: Get and collect drops
        dropsRemote:FireServer(Instance.new("Attachment"))
        task.wait(1)
        collectDrops()
        
        -- Reset inventory check flag after use
        batteryInventoryCheck.Value = false
    end
end
