-- [[ CONFIGURATION ]] --
local TWEEN_SPEED = 50 -- Lower is slower and safer; higher is faster.
local INTERACT_DELAY = 0.5 -- Time to wait to ensure the action registers.

-- [[ SERVICES ]] --
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Track deposit counts per station object
local depositTracker = {}

-- Watch for character respawns
LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    HumanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
end)

-- [[ HELPER FUNCTIONS ]] --

-- Smoothly teleports the player using a Tween to avoid instant-teleport bans
local function safeTeleport(targetCFrame)
    if not HumanoidRootPart then return end
    local distance = (HumanoidRootPart.Position - targetCFrame.Position).Magnitude
    local duration = distance / TWEEN_SPEED
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
    task.wait(0.2)
end

-- Simulates interaction
local function triggerInteraction(proximityPrompt)
    if proximityPrompt then
        proximityPrompt:InputHoldBegin()
        task.wait(proximityPrompt.HoldDuration + 0.1)
        proximityPrompt:InputHoldEnd()
    else
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
    task.wait(INTERACT_DELAY)
end

-- Finds all matching objects in Workspace
local function findObjects()
    local batteries = {}
    local deposits = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Identify Batteries
        if obj:IsA("ProximityPrompt") and string.find(string.lower(obj.ObjectText or ""), "battery") then
            table.insert(batteries, obj.Parent)
        elseif string.find(string.lower(obj.Name), "battery") and not string.find(string.lower(obj.Name), "deposit") then
            if obj:IsA("BasePart") or obj:IsA("Model") then
                table.insert(batteries, obj)
            end
        end
        
        -- Identify Deposits / Ships
        if string.find(string.lower(obj.Name), "deposit") or string.find(string.lower(obj.Name), "ufo") or string.find(string.lower(obj.Name), "ship") then
            if obj:IsA("BasePart") or obj:IsA("Model") then
                table.insert(deposits, obj)
            end
        end
    end
    return batteries, deposits
end

-- Checks if a specific deposit station already contains a battery via physical child objects or UI
local function hasBattery(deposit)
    for _, child in ipairs(deposit:GetDescendants()) do
        if string.find(string.lower(child.Name), "battery") and child:IsA("BasePart") then
            return true
        end
    end
    local statusText = deposit:FindFirstChildOfClass("BillboardGui") or deposit:FindFirstChildOfClass("SurfaceGui")
    if statusText then
        local label = statusText:FindFirstChildOfClass("TextLabel")
        if label and (string.find(string.lower(label.Text), "1/") or string.find(string.lower(label.Text), "active")) then
            return true
        end
    end
    return false
end

-- [[ MAIN LOOP ]] --
local function startLoop()
    while true do
        local batteries, deposits = findObjects()
        local characterHasBattery = Character:FindFirstChild("Battery") or LocalPlayer.Backpack:FindFirstChild("Battery")

        if not characterHasBattery and #batteries > 0 then
            -- 1. Grab a Battery
            local targetBattery = batteries[1]
            local targetPart = targetBattery:IsA("Model") and targetBattery.PrimaryPart or targetBattery
            
            if targetPart then
                print("Teleporting to Battery...")
                safeTeleport(targetPart.CFrame * CFrame.new(0, 2, 0))
                
                local prompt = targetBattery:FindFirstChildOfClass("ProximityPrompt") or targetPart:FindFirstChildOfClass("ProximityPrompt")
                triggerInteraction(prompt)
            end
            
        elseif #deposits > 0 then
            -- 2. Determine Deposit Target based on conditions
            local targetDeposit = nil
            local emptyDeposits = {}
            local filledDeposits = {}
            
            for _, dep in ipairs(deposits) do
                if hasBattery(dep) then
                    table.insert(filledDeposits, dep)
                else
                    table.insert(emptyDeposits, dep)
                end
            end
            
            if #filledDeposits > 0 then
                targetDeposit = filledDeposits[math.random(1, #filledDeposits)]
                print("Targeting an active/filled Deposit...")
            elseif #emptyDeposits > 0 then
                targetDeposit = emptyDeposits[math.random(1, #emptyDeposits)]
                print("No filled stations found. Teleporting to a random empty Deposit...")
            end
            
            -- 3. Teleport and Deposit
            if targetDeposit then
                local targetPart = targetDeposit:IsA("Model") and targetDeposit.PrimaryPart or targetDeposit
                if targetPart then
                    safeTeleport(targetPart.CFrame * CFrame.new(0, 3, 0))
                    
                    local prompt = targetDeposit:FindFirstChildOfClass("ProximityPrompt") or targetPart:FindFirstChildOfClass("ProximityPrompt")
                    triggerInteraction(prompt)
                    
                    -- Track success on this particular deposit station
                    if not depositTracker[targetDeposit] then
                        depositTracker[targetDeposit] = 0
                    end
                    depositTracker[targetDeposit] = depositTracker[targetDeposit] + 1
                    print("Deposited to station. Count for this station: " .. tostring(depositTracker[targetDeposit]))
                    
                    -- Check if 2 batteries have been successfully deposited here
                    if depositTracker[targetDeposit] >= 2 then
                        local waitTime = math.random(3, 5)
                        print("2 batteries deposited to this station! Waiting " .. tostring(waitTime) .. " seconds...")
                        task.wait(waitTime)
                        depositTracker[targetDeposit] = 0 -- Reset counter for this station after waiting
                    end
                end
            end
        end
        
        task.wait(1)
    end
end

-- Run the script safely
pcall(startLoop)
