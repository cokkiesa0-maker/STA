-- // Configuration
local TWEEN_SPEED = 50 -- Adjust speed if the game has anti-cheat for teleporting (Studs per second)
local USE_TWEENING = true -- Set to false for instant teleportation (Risky if anti-cheat is present)

-- // Services & Remotes
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local GrabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local DepositRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

-- // Target Attachments
local Terrain = Workspace:WaitForChild("Terrain")
local BatteryAttachment = Terrain:WaitForChild("BatterySpawnAttachment")
local CrateAttachment = Terrain:WaitForChild("EggCrateSpawnAttachment")

-- // Helper Function: Safe Teleportation/Tweening
local function teleportTo(targetCFrame)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    if USE_TWEENING then
        local distance = (rootPart.Position - targetCFrame.Position).Magnitude
        local duration = distance / TWEEN_SPEED
        local tween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        
        tween:Play()
        tween.Completed:Wait()
    else
        rootPart.CFrame = targetCFrame
        task.wait(0.1) -- Small delay for physics sync
    end
end

-- // Helper Function: Lock/Unlock Position
local function toggleAnchor(state)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        rootPart.Anchored = state
    end
end

-- // Main Automation Loop
local function startAutomation()
    while true do
        print("[Auto-Farm] Moving to Battery...")
        
        -- 1. Teleport to Battery and Grab it
        -- Using WorldCFrame since it's an Attachment
        teleportTo(BatteryAttachment.WorldCFrame) 
        task.wait(0.2) -- Brief pause to ensure alignment
        
        GrabRemote:FireServer(BatteryAttachment)
        print("[Auto-Farm] Battery Grabbed!")
        task.wait(0.5)

        -- 2. Teleport to Crate and Deposit
        print("[Auto-Farm] Moving to Deposit Crate...")
        teleportTo(CrateAttachment.WorldCFrame)
        task.wait(0.2)

        DepositRemote:FireServer(CrateAttachment)
        print("[Auto-Farm] Battery Deposited!")

        -- 3. Lock Position and Wait 3 Seconds (Bypass anti-rubberband/teleport back)
        print("[Auto-Farm] Locking position for 3 seconds...")
        toggleAnchor(true)
        task.wait(3)
        toggleAnchor(false)
        
        print("[Auto-Farm] Cycle complete. Restarting...")
        task.wait(1) -- Safety delay between cycles
    end
end

-- Start the script
task.spawn(startAutomation)
