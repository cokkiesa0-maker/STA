-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Local player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Target references
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment") -- This is our deposit lock point
local lockPosition = crateDeposit.WorldCFrame + Vector3.new(0, 1.5, 0) -- Lock position with height offset

-- Remotes
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Function to lock position to deposit
local function maintainDepositLock()
    while true do
        task.wait(0.1) -- Check position frequently
        if humanoidRootPart then
            -- Keep player at the lock position
            humanoidRootPart.CFrame = lockPosition
            -- Optional: Prevent movement input
            humanoid.WalkSpeed = 0
        end
    end
end

-- Function to collect drops near deposit
local function collectDrops()
    task.wait(1)
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Name == "BatteryDrop" then
            humanoidRootPart.CFrame = part.WorldCFrame + Vector3.new(0, 1, 0)
            task.wait(0.5)
        end
    end
end

-- Main flow: Collect battery, then lock to deposit
teleportTo(batterySpawn)
grabRemote:FireServer(batterySpawn)

-- Move to deposit and lock position permanently
humanoidRootPart.CFrame = lockPosition
task.spawn(maintainDepositLock) -- Run lock in background

-- Repeat interaction and collection while locked
while task.wait(3) do
    useRemote:FireServer(crateDeposit)
    dropsRemote:FireServer(Instance.new("Attachment"))
    collectDrops()
end

-- Helper teleport function
function teleportTo(target)
    humanoid.WalkSpeed = 16 -- Temporarily allow movement
    humanoidRootPart.CFrame = target.WorldCFrame + Vector3.new(0, 2, 0)
    task.wait(1)
end
