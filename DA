-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Configuration
local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GrabBattery = Remotes:WaitForChild("GrabBatteryRemote")
local UseBattery = Remotes:WaitForChild("UseBatteryOnCrateRemote")
local Terrain = Workspace:WaitForChild("Terrain")

-- Scan Function
local function scanForTargets()
    local battery = Terrain:WaitForChild("BatterySpawnAttachment", 5)
    local deposit = Terrain:WaitForChild("EggCrateSpawnAttachment", 5)
    
    if battery and deposit then
        return battery, deposit
    end
    return nil, nil
end

-- Teleport Helper
local function teleportTo(targetAttachment)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if rootPart and targetAttachment then
        rootPart.CFrame = targetAttachment.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.25) -- Safe delay for physics sync
        return true
    end
    return false
end

-- Main Automation
local function startAutoFarm()
    local battery, deposit = scanForTargets()
    if not (battery and deposit) then 
        warn("Target scan failed. Script stopped.")
        return 
    end

    while true do
        -- 1. Teleport to Battery & Grab
        if teleportTo(battery) then
            GrabBattery:FireServer(battery)
            task.wait(0.3) -- Short delay to ensure server registers the grab
        end

        -- 2. Teleport to Deposit & Use
        if teleportTo(deposit) then
            UseBattery:FireServer(deposit)
            task.wait(0.2)
            
            -- 3. Lock Position for 3 seconds
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.Anchored = true
                task.wait(3)
                rootPart.Anchored = false
            end
        end
        
        task.wait(0.5) -- Loop cooldown
    end
end

task.spawn(startAutoFarm)
