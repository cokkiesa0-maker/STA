-- CONFIGURABLE SETTINGS (same as before)
local GRAB_DELAY = 0.5
local DEPOSIT_DELAY = 0.5
local SPAWN_CHECK_INTERVAL = 1
local TELEPORT_DELAY = 0.2

-- SERVICES & DEPENDENCY WAIT CHECKS (same as before)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes", 30)
local GrabBatteryRemote = RemotesFolder:WaitForChild("GrabBatteryRemote", 30)
local UseBatteryOnCrateRemote = RemotesFolder:WaitForChild("UseBatteryOnCrateRemote", 30)

local Terrain = Workspace:WaitForChild("Terrain", 30)
local BatterySpawn = Terrain:WaitForChild("BatterySpawnAttachment", 30)
local EggCrateSpawn = Terrain:WaitForChild("EggCrateSpawnAttachment", 30)

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid", 10)
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 10)

-- UPDATED BATTERY CHECK FUNCTION - TRY THESE OPTIONS!
local function hasBattery()
    -- OPTION 1: Check for battery tool (try different names if needed)
    local toolNames = {"Battery", "BatteryItem", "PowerCell"}
    for _, name in ipairs(toolNames) do
        if LocalPlayer.Backpack:FindFirstChild(name) or Character:FindFirstChild(name) then
            print("Found battery tool: " .. name)
            return true
        end
    end

    -- OPTION 2: Check for a value/attribute on the player (common in many games)
    if LocalPlayer:GetAttribute("HasBattery") then
        print("Player has battery attribute set")
        return true
    end
    if LocalPlayer:FindFirstChild("HasBattery") and LocalPlayer.HasBattery.Value then
        print("Player has battery value set")
        return true
    end

    -- OPTION 3: Check if battery exists in character's inventory/equip slot
    if Humanoid:GetAttribute("EquippedBattery") then
        print("Battery equipped on humanoid")
        return true
    end

    -- If none found, return false
    print("No battery detected - checked tools, attributes and values")
    return false
end

-- ADDITIONAL FIX: Add a small wait after firing remote to let game update state
-- Main farming loop (updated section)
while task.wait() do
    local batteryAcquired = false
    while not batteryAcquired do
        -- Character validity check (same as before)
        if not HumanoidRootPart or not Humanoid or Humanoid.Health <= 0 then
            Character = LocalPlayer.CharacterAdded:Wait()
            Humanoid = Character:WaitForChild("Humanoid", 10)
            HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 10)
            task.wait(TELEPORT_DELAY)
        end

        -- Teleport to spawn
        HumanoidRootPart.CFrame = BatterySpawn.WorldCFrame + Vector3.new(0, 2, 0)
        task.wait(TELEPORT_DELAY)

        -- Fire remote with extra safety
        task.wait(GRAB_DELAY)
        local success = pcall(function()
            GrabBatteryRemote:FireServer(BatterySpawn)
        end)
        if not success then
            print("Failed to fire grab remote - retrying")
            task.wait(SPAWN_CHECK_INTERVAL)
            continue
        end
        task.wait(GRAB_DELAY * 2) -- DOUBLE THE DELAY HERE TO LET GAME REGISTER THE PICKUP

        -- Verify again with multiple checks
        if hasBattery() then
            batteryAcquired = true
            print("Battery successfully acquired!")
        else
            print("Battery not detected - retrying...")
            task.wait(SPAWN_CHECK_INTERVAL)
        end
    end

    -- Deposit section (same as before but with extra delay)
    if batteryAcquired then
        if not HumanoidRootPart or not Humanoid or Humanoid.Health <= 0 then
            Character = LocalPlayer.CharacterAdded:Wait()
            Humanoid = Character:WaitForChild("Humanoid", 10)
            HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 10)
            task.wait(TELEPORT_DELAY)
        end

        HumanoidRootPart.CFrame = EggCrateSpawn.WorldCFrame + Vector3.new(0, 2, 0)
        task.wait(TELEPORT_DELAY)

        task.wait(DEPOSIT_DELAY)
        pcall(function()
            UseBatteryOnCrateRemote:FireServer(EggCrateSpawn)
        end)
        task.wait(DEPOSIT_DELAY * 2) -- Extra delay here too

        if not hasBattery() then
            print("Battery successfully deposited! Waiting 3 seconds...")
            task.wait(3)
        else
            print("Deposit may have failed - checking again...")
            task.wait(DEPOSIT_DELAY)
        end
    end
end
