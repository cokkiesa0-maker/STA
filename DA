--// Configuration
local TWEEN_SPEED = 100 -- Studs per second (Adjust if you get kicked for teleporting)
local DEPOSIT_DELAY = 3 -- Seconds to wait/lock position after depositing

--// Services & Player Details
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

--// Remotes
local GrabBatteryRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local UseBatteryOnCrateRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

--// Safely get targets from Workspace
local Terrain = workspace:WaitForChild("Terrain")
local Battery = Terrain:WaitForChild("BatterySpawnAttachment")
local EggCrate = Terrain:WaitForChild("EggCrateSpawnAttachment")

--// Utility Function: Bypass standard teleports using Tweening (Prevents rubberbanding)
local function teleportTo(targetAttachment)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    if targetAttachment and rootPart then
        local targetCFrame = CFrame.new(targetAttachment.WorldPosition)
        local distance = (rootPart.Position - targetAttachment.WorldPosition).Magnitude
        local duration = distance / TWEEN_SPEED
        
        local tween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end
end

--// Utility Function: Lock character position
local function anchorCharacter(state)
    local character = LocalPlayer.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.Anchored = state
        end
    end
end

--// FEATURE 1 & 2: Auto Battery Grab & Deposit Loop
task.spawn(function()
    while true do
        pcall(function()
            -- 1. Teleport to Battery and Grab it
            teleportTo(Battery)
            task.wait(0.1)
            GrabBatteryRemote:FireServer(Battery)
            task.wait(0.2)
            
            -- 2. Teleport to Crate and Deposit it
            teleportTo(EggCrate)
            task.wait(0.1)
            UseBatteryOnCrateRemote:FireServer(EggCrate)
            
            -- 3. Lock position and wait 3 seconds (Bypasses running or snapping back)
            anchorCharacter(true)
            task.wait(DEPOSIT_DELAY)
            anchorCharacter(false)
        end)
        task.wait(0.5) -- Small cooldown before restarting the loop
    end
end)

--// FEATURE 3: Instant Ore Block Destroyer via Dragon Breath
task.spawn(function()
    while true do
        pcall(function()
            local character = LocalPlayer.Character
            if character then
                local dragonsFolder = character:FindFirstChild("Dragons")
                if dragonsFolder then
                    -- Dynamically find whichever dragon is currently active/equipped
                    for _, dragon in ipairs(dragonsFolder:GetChildren()) do
                        local remotes = dragon:FindFirstChild("Remotes")
                        local breathRemote = remotes and remotes:FindFirstChild("BreathFireRemote")
                        
                        if breathRemote then
                            -- Spams the server with the breath execution to break blocks instantly
                            breathRemote:FireServer(false)
                        end
                    end
                end
            end
        end)
        task.wait(0.05) -- Fast fire rate for instant destruction
    end
end)
