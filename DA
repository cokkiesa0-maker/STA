-- CONFIGURABLE SETTINGS
local TELEPORT_OFFSET = Vector3.new(0, 2, 0) -- Prevent ground clipping
local GRAB_DELAY = 0.3 -- Small delay to avoid remote spam
local DEPOSIT_DELAY = 0.3
local POST_DEPOSIT_WAIT = 3 -- Exact lock time at deposit location
local RETRY_DELAY = 1 -- Wait before retrying if interaction fails

-- SERVICES & DEPENDENCY SAFETY CHECKS
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Wait for critical objects to load (30s timeout max)
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
local GrabRemote = Remotes:WaitForChild("GrabBatteryRemote", 30)
local DepositRemote = Remotes:WaitForChild("UseBatteryOnCrateRemote", 30)

local Terrain = Workspace:WaitForChild("Terrain", 30)
local BatteryPoint = Terrain:WaitForChild("BatterySpawnAttachment", 30)
local DepositPoint = Terrain:WaitForChild("EggCrateSpawnAttachment", 30)

-- Player/Character References
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart", 10)
local Humanoid = Character:WaitForChild("Humanoid", 10)

-- BATTERY DETECTION - UPDATE THIS TO MATCH YOUR GAME!
-- Replace with how your game confirms battery possession
local function hasBattery()
    -- Example checks - uncomment/modify the one that works:
    -- 1. Check for tool in backpack/character
    return LocalPlayer.Backpack:FindFirstChild("Battery") or Character:FindFirstChild("Battery")
    -- 2. Check player attribute
    -- return LocalPlayer:GetAttribute("HoldingBattery") == true
    -- 3. Check player value object
    -- return LocalPlayer:FindFirstChild("HasBattery") and LocalPlayer.HasBattery.Value
end

-- Helper: Safely teleport character
local function teleportTo(target)
    if not RootPart or Humanoid.Health <= 0 then
        Character = LocalPlayer.CharacterAdded:Wait()
        RootPart = Character:WaitForChild("HumanoidRootPart", 10)
        Humanoid = Character:WaitForChild("Humanoid", 10)
    end
    RootPart.CFrame = target.WorldCFrame + TELEPORT_OFFSET
    task.wait(0.1) -- Small pause for game to register position
end

-- MAIN FARMING LOOP
while true do
    -- STEP 1: GET BATTERY
    print("Heading to battery spawn...")
    local batteryGot = false
    
    while not batteryGot do
        -- Teleport to battery location
        teleportTo(BatteryPoint)
        
        -- Auto-trigger grab interaction
        task.wait(GRAB_DELAY)
        local success = pcall(function()
            GrabRemote:FireServer(BatteryPoint)
        end)
        
        if success then
            task.wait(GRAB_DELAY) -- Let game process pickup
            batteryGot = hasBattery()
            if batteryGot then
                print("✅ Battery collected!")
            else
                print("❌ Battery not found - retrying...")
                task.wait(RETRY_DELAY)
            end
        else
            print("❌ Failed to trigger grab - retrying...")
            task.wait(RETRY_DELAY)
        end
    end

    -- STEP 2: DEPOSIT BATTERY
    print("Heading to deposit point...")
    teleportTo(DepositPoint)
    
    -- Auto-trigger deposit interaction
    task.wait(DEPOSIT_DELAY)
    local depositSuccess = pcall(function()
        DepositRemote:FireServer(DepositPoint)
    end)
    
    if depositSuccess then
        task.wait(DEPOSIT_DELAY) -- Let game process deposit
        if not hasBattery() then
            print("✅ Battery deposited! Locking position for " .. POST_DEPOSIT_WAIT .. "s...")
            task.wait(POST_DEPOSIT_WAIT) -- Exact lock time
        else
            print("❌ Deposit failed - retrying deposit...")
            task.wait(RETRY_DELAY)
        end
    else
        print("❌ Failed to trigger deposit - retrying...")
        task.wait(RETRY_DELAY)
    end
end
