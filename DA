-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Random = Random.new()

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Remotes & Attachments
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

local batteryAttach = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateAttach = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

-- Settings
local TELEPORT_OFFSET = Vector3.new(0, 2, 0)
local BASE_DELAY = 1
local MAX_STUCK_WAIT = 5
local RANDOM_TELEPORT_CHANCE = 0.3 -- 30% chance to teleport randomly each cycle

-- State tracking
local lastActionTime = os.clock()
local currentTarget = batteryAttach

-- Safe teleport function
local function teleport(target)
    if humanoid.Health <= 0 or not humanoidRootPart then return end
    -- Add small random offset to avoid getting stuck in same spot
    local randomOffset = Vector3.new(Random:NextNumber(-1,1), 0, Random:NextNumber(-1,1))
    humanoidRootPart.CFrame = target.WorldCFrame + TELEPORT_OFFSET + randomOffset
    lastActionTime = os.clock()
    wait(BASE_DELAY)
end

-- Random teleport fallback
local function tryRandomTeleport()
    if Random:NextNumber() <= RANDOM_TELEPORT_CHANCE then
        print("Doing random teleport to fix sticking...")
        -- Choose random target or a spot between them
        local randomTarget = Random:NextBoolean() and batteryAttach or crateAttach
        teleport(randomTarget)
    end
end

-- MAIN LOOP
while true do
    wait(BASE_DELAY)

    -- Check if stuck (no action for too long)
    if os.clock() - lastActionTime > MAX_STUCK_WAIT then
        print("Looks stuck - triggering fallback teleport!")
        tryRandomTeleport()
        -- Switch target to force movement
        currentTarget = currentTarget == batteryAttach and crateAttach or batteryAttach
        lastActionTime = os.clock()
        continue
    end

    -- Regular cycle with random chance to teleport
    if Random:NextNumber() <= RANDOM_TELEPORT_CHANCE then
        tryRandomTeleport()
    end

    -- Step 1: Go to battery & grab
    print("Teleporting to battery...")
    teleport(batteryAttach)
    grabRemote:FireServer(batteryAttach)
    wait(BASE_DELAY + Random:NextNumber(0.5, 1.5)) -- Random wait to avoid pattern

    -- Step 2: Go to crate & deposit
    print("Teleporting to crate...")
    teleport(crateAttach)
    useRemote:FireServer(crateAttach)
    wait(BASE_DELAY + Random:NextNumber(0.5, 2)) -- Random wait between cycles

    -- Extra random teleport at end of cycle sometimes
    if Random:NextBoolean() then
        tryRandomTeleport()
    end
end

