-- ==========================================
-- ENHANCED ERROR HANDLING & DEBUGGING
-- ==========================================
local DEBUG_MODE = true

local function debugLog(message)
    if DEBUG_MODE then
        print("[DEBUG] " .. tostring(message))
    end
end

local function errorLog(message)
    print("[ERROR] " .. tostring(message))
    warn("[ERROR] " .. tostring(message))
end

-- ==========================================
-- LOAD RAYFIELD WITH FALLBACK
-- ==========================================
local Rayfield
local rayFieldLoaded = false
local Window = nil

local success, err = pcall(function()
    debugLog("Attempting to load Rayfield UI Library...")
    
    local rayFieldSuccess, rayFieldErr = pcall(function()
        debugLog("Fetching Rayfield from URL...")
        local response = game:HttpGet('https://sirius.menu/rayfield')
        if response and response ~= "" then
            debugLog("Rayfield response received, loading...")
            Rayfield = loadstring(response)()
            rayFieldLoaded = true
            debugLog("✅ Rayfield loaded successfully")
        else
            errorLog("Rayfield URL returned empty response")
        end
    end)
    
    if not rayFieldSuccess then
        errorLog("Failed to load Rayfield: " .. tostring(rayFieldErr))
        errorLog("Continuing without UI (console mode)")
        rayFieldLoaded = false
    end
    
    -- If Rayfield failed, create a simple fallback UI system
    if not rayFieldLoaded then
        debugLog("Creating fallback UI system...")
        Rayfield = {
            CreateWindow = function(self, config)
                debugLog("Fallback: Creating window")
                return {
                    CreateTab = function(self, name, icon)
                        debugLog("Fallback: Creating tab: " .. tostring(name))
                        return {
                            CreateSection = function(self, name)
                                print("[SECTION] " .. tostring(name))
                                return self
                            end,
                            CreateToggle = function(self, config)
                                local toggleName = (config and config.Name) or "Unknown Toggle"
                                print("[TOGGLE] " .. tostring(toggleName))
                                return self
                            end,
                            CreateSlider = function(self, config)
                                local sliderName = (config and config.Name) or "Unknown Slider"
                                print("[SLIDER] " .. tostring(sliderName))
                                return self
                            end,
                            CreateButton = function(self, config)
                                local buttonName = (config and config.Name) or "Unknown Button"
                                print("[BUTTON] " .. tostring(buttonName))
                                return self
                            end,
                            CreateLabel = function(self, text)
                                print("[LABEL] " .. tostring(text))
                                return self
                            end
                        }
                    end,
                    Destroy = function(self)
                        debugLog("Fallback: Window destroyed")
                    end
                }
            end
        }
    end
    
    -- Window Configuration
    if not Rayfield then
        errorLog("FATAL: Rayfield is still nil after initialization")
        return
    end
    
    debugLog("Creating window...")
    Window = Rayfield:CreateWindow({
        Name = "Battery Automation Hub",
        Icon = 0,
        LoadingTitle = "Loading Automation...",
        LoadingSubtitle = "Please wait",
        Theme = "Default",
        DisableRayfieldPrompts = false,
        DisableBuildWarnings = false,
        ConfigurationSaving = {
            Enabled = false,
            FolderName = nil,
            FileName = "WorkspaceConfig"
        },
        Discord = {
            Enabled = false,
            Invite = "noinvitelink",
            RememberJoins = true
        },
        KeySystem = false
    })
    
    if not Window then
        errorLog("FATAL: Window creation failed")
        return
    end
    
    debugLog("Window created successfully")
    
    -- ==========================================
    -- GLOBAL VARIABLES
    -- ==========================================
    local _G = _G or {}
    _G.AutoFarm = false
    _G.AutoTeleport = false
    _G.FarmDelay = 0.3
    
    -- ==========================================
    -- GAME SERVICES
    -- ==========================================
    debugLog("Initializing game services...")
    
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local workspace = game:GetService("Workspace")
    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer
    
    if not localPlayer then
        errorLog("LocalPlayer not found!")
        return
    end
    
    debugLog("✅ Game services initialized")
    
    -- ==========================================
    -- GET REMOTES WITH ENHANCED ERROR HANDLING
    -- ==========================================
    debugLog("Searching for Remotes...")
    
    local remotes = replicatedStorage:WaitForChild("Remotes", 5)
    if not remotes then
        errorLog("Remotes folder not found in ReplicatedStorage after 5 seconds")
        local children = replicatedStorage:GetChildren()
        local childNames = {}
        for _, child in ipairs(children) do
            table.insert(childNames, child.Name)
        end
        errorLog("Available in ReplicatedStorage: " .. table.concat(childNames, ", "))
        remotes = nil
    else
        debugLog("✅ Remotes folder found")
    end
    
    local grabBatteryRemote = nil
    local useBatteryRemote = nil
    
    if remotes then
        grabBatteryRemote = remotes:WaitForChild("GrabBatteryRemote", 3)
        useBatteryRemote = remotes:WaitForChild("UseBatteryOnCrateRemote", 3)
        
        if grabBatteryRemote then debugLog("✅ GrabBatteryRemote found") else errorLog("GrabBatteryRemote not found") end
        if useBatteryRemote then debugLog("✅ UseBatteryOnCrateRemote found") else errorLog("UseBatteryOnCrateRemote not found") end
        
        if not grabBatteryRemote or not useBatteryRemote then
            local remoteNames = {}
            for _, remote in ipairs(remotes:GetChildren()) do
                table.insert(remoteNames, remote.Name)
            end
            errorLog("Available remotes: " .. table.concat(remoteNames, ", "))
        end
    end
    
    -- ==========================================
    -- GET GAME OBJECTS WITH ENHANCED ERROR HANDLING
    -- ==========================================
    debugLog("Searching for game objects...")
    
    local terrain = workspace:WaitForChild("Terrain", 3)
    if not terrain then
        errorLog("Terrain not found in Workspace after 3 seconds")
        terrain = nil
    else
        debugLog("✅ Terrain found")
    end
    
    local batteryAttachment = nil
    local eggCrateAttachment = nil
    
    if terrain then
        batteryAttachment = terrain:WaitForChild("BatterySpawnAttachment", 3)
        eggCrateAttachment = terrain:WaitForChild("EggCrateSpawnAttachment", 3)
        
        if batteryAttachment then debugLog("✅ BatterySpawnAttachment found") else errorLog("BatterySpawnAttachment not found") end
        if eggCrateAttachment then debugLog("✅ EggCrateSpawnAttachment found") else errorLog("EggCrateSpawnAttachment not found") end
        
        if not batteryAttachment or not eggCrateAttachment then
            local terrainChildren = {}
            for _, child in ipairs(terrain:GetChildren()) do
                table.insert(terrainChildren, child.Name)
            end
            errorLog("Available in Terrain: " .. table.concat(terrainChildren, ", "))
        end
    end
    
    -- ==========================================
    -- TAB 1: AUTOMATION
    -- ==========================================
    local AutomationTab = Window:CreateTab("Automation", 0)
    AutomationTab:CreateSection("Battery Settings")
    
    AutomationTab:CreateToggle({
        Name = "Auto Grab & Use Battery",
        CurrentValue = false,
        Flag = "MainFarmToggleFlag",
        Callback = function(Value)
            _G.AutoFarm = Value
            if Value then
                if not grabBatteryRemote or not useBatteryRemote then
                    errorLog("Cannot start farm: Remotes not available!")
                    _G.AutoFarm = false
                    return
                end
                
                task.spawn(function()
                    while _G.AutoFarm do
                        if grabBatteryRemote and batteryAttachment then
                            local farmSuccess, farmErr = pcall(function()
                                grabBatteryRemote:FireServer(batteryAttachment)
                            end)
                            if not farmSuccess then
                                errorLog("Error grabbing battery: " .. tostring(farmErr))
                            end
                        end
                        task.wait(_G.FarmDelay)
                        
                        if useBatteryRemote and eggCrateAttachment then
                            local useSuccess, useErr = pcall(function()
                                useBatteryRemote:FireServer(eggCrateAttachment)
                            end)
                            if not useSuccess then
                                errorLog("Error using battery: " .. tostring(useErr))
                            end
                        end
                        task.wait(_G.FarmDelay)
                    end
                end)
            end
        end,
    })
    
    AutomationTab:CreateSlider({
        Name = "Farm Speed Delay",
        Range = {0.1, 2},
        Increment = 0.1,
        Suffix = "s",
        CurrentValue = 0.3,
        Flag = "DelaySettingSlider",
        Callback = function(Value)
            _G.FarmDelay = Value
            debugLog("Farm delay set to: " .. Value .. "s")
        end,
    })
    
    -- ==========================================
    -- TAB 2: TELEPORTS
    -- ==========================================
    local TeleportTab = Window:CreateTab("Teleports", 0)
    TeleportTab:CreateSection("Movement")
    
    TeleportTab:CreateToggle({
        Name = "Auto Teleport to Crate Loop",
        CurrentValue = false,
        Flag = "TPLoopToggle",
        Callback = function(Value)
            _G.AutoTeleport = Value
            if Value then
                if not eggCrateAttachment then
                    errorLog("Cannot start teleport loop: EggCrateAttachment not available!")
                    _G.AutoTeleport = false
                    return
                end
                
                task.spawn(function()
                    while _G.AutoTeleport do
                        local character = localPlayer.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")
                        if hrp and eggCrateAttachment then
                            local tpSuccess, tpErr = pcall(function()
                                hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
                            end)
                            if not tpSuccess then
                                errorLog("Teleport error: " .. tostring(tpErr))
                            end
                        end
                        task.wait(1)
                    end
                end)
            end
        end,
    })
    
    TeleportTab:CreateSection("Instant Waypoints")
    
    TeleportTab:CreateButton({
        Name = "Teleport to Crate (Once)",
        Callback = function()
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp and eggCrateAttachment then
                local crateTPSuccess, crateTpErr = pcall(function()
                    hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
                    debugLog("Teleported to crate")
                end)
                if not crateTPSuccess then
                    errorLog("Teleport failed: " .. tostring(crateTpErr))
                end
            else
                errorLog("Cannot teleport: HRP or Crate Attachment missing")
            end
        end,
    })
    
    TeleportTab:CreateButton({
        Name = "Teleport to Battery Spawn (Once)",
        Callback = function()
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp and batteryAttachment then
                local batteryTPSuccess, batteryTpErr = pcall(function()
                    hrp.CFrame = CFrame.new(batteryAttachment.WorldPosition + Vector3.new(0, 3, 0))
                    debugLog("Teleported to battery spawn")
                end)
                if not batteryTPSuccess then
                    errorLog("Teleport failed: " .. tostring(batteryTpErr))
                end
            else
                errorLog("Cannot teleport: HRP or Battery Attachment missing")
            end
        end,
    })
    
    -- ==========================================
    -- TAB 3: DEBUG INFO
    -- ==========================================
    local InfoTab = Window:CreateTab("Info", 0)
    InfoTab:CreateSection("Script Status")
    
    local statusText = "✅ Script Loaded"
    if not rayFieldLoaded then
        statusText = statusText .. " (Fallback UI Mode)"
    end
    InfoTab:CreateLabel(statusText)
    InfoTab:CreateLabel("Rayfield UI: " .. (rayFieldLoaded and "✅" or "⚠️ Fallback"))
    InfoTab:CreateLabel("LocalPlayer: " .. (localPlayer and "✅" or "❌"))
    InfoTab:CreateLabel("Remotes: " .. (remotes and "✅" or "❌"))
    InfoTab:CreateLabel("GrabBatteryRemote: " .. (grabBatteryRemote and "✅" or "❌"))
    InfoTab:CreateLabel("UseBatteryRemote: " .. (useBatteryRemote and "✅" or "❌"))
    InfoTab:CreateLabel("Terrain: " .. (terrain and "✅" or "❌"))
    InfoTab:CreateLabel("BatterySpawnAttachment: " .. (batteryAttachment and "✅" or "❌"))
    InfoTab:CreateLabel("EggCrateAttachment: " .. (eggCrateAttachment and "✅" or "❌"))
    
    InfoTab:CreateSection("Console Output")
    InfoTab:CreateLabel("Check console for detailed debug logs")
    
    debugLog("✅ All systems initialized")
    
end)

if not success then
    errorLog("CRITICAL SCRIPT ERROR: " .. tostring(err))
    print(debug.traceback())
end
