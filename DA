-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Target positions (double-check these paths!)
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateDeposit = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local batteryPosition = batterySpawn.WorldCFrame + Vector3.new(0, 2, 0) -- Higher offset to avoid clipping
local depositPosition = crateDeposit.WorldCFrame + Vector3.new(0, 1.5, 0)

-- Remotes
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Lock connection
local lockConnection = nil

-- Fully enable movement and clear locks
local function enableMovement()
    if lockConnection then
        lockConnection:Disconnect()
        lockConnection = nil
    end
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
    humanoid.AutoRotate = true
end

-- Lock at deposit for 3 seconds
local function lockAtDeposit()
    enableMovement()
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false

    lockConnection = RunService.Heartbeat:Connect(function()
        if humanoidRootPart then
            humanoidRootPart.CFrame = depositPosition
        end
    end)

    task.delay(3, enableMovement)
end

-- **FIXED BATTERY COLLECTION** - ensures we get it before moving on
local function getBattery()
    print("Collecting battery first - no deposit until done!")
    enableMovement()

    -- Force character to battery location
    humanoidRootPart.Anchored = true -- Temporarily anchor to guarantee position
    humanoidRootPart.CFrame = batteryPosition
    task.wait(1)
    humanoidRootPart.Anchored = false -- Unanchor after moving

    -- Wait for character to settle
    task.wait(1.5)

    -- Fire remote multiple times to ensure it registers
    for i = 1, 2 do
        grabRemote:FireServer(batterySpawn)
        task.wait(0.5)
    end

    print("Battery collected - heading to deposit")
end

-- Main cycle - STRICT ORDER: BATTERY FIRST → DEPOSIT
while true do
    getBattery() -- Will not proceed until battery is collected

    -- Move to deposit and lock
    humanoidRootPart.CFrame = depositPosition
    task.wait(1)
    lockAtDeposit()

    -- Use battery
    useRemote:FireServer(crateDeposit)
    task.wait(1)
    dropsRemote:FireServer(Instance.new("Attachment"))

    -- Wait before next battery run
    task.wait(2)
end
