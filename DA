-- Fallback source link to bypass executor network filter blocks
local loadstringUrl = 'https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua'
local Rayfield = loadstring(game:HttpGet(loadstringUrl))()

-- Fully populated Window settings to prevent silent crashes
local Window = Rayfield:CreateWindow({
    Name = "Battery Automation Hub",
    Icon = 0, 
    LoadingTitle = "Loading Automation...",
    LoadingSubtitle = "Please wait",
    Theme = "Default",
    DisableRayfieldPrompts = false,
    DisableBuildWarnings = false,
    ConfigurationSaving = {
        Enabled = false,
        FolderName = nil,
        FileName = "WorkspaceConfig"
    },
    Discord = {
        Enabled = false,
        Invite = "noinvitelink",
        RememberJoins = true
    },
    KeySystem = false
})

-- Shared Loop Variables
local _G = _G or {}
_G.AutoFarm = false
_G.AutoTeleport = false
_G.FarmDelay = 0.3

-- Engine paths with fallback protections
local replicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer

local remotes = replicatedStorage:WaitForChild("Remotes", 5)
local grabBatteryRemote = remotes and remotes:WaitForChild("GrabBatteryRemote", 5)
local useBatteryRemote = remotes and remotes:WaitForChild("UseBatteryOnCrateRemote", 5)

local terrain = workspace:WaitForChild("Terrain", 5)
local batteryAttachment = terrain and terrain:WaitForChild("BatterySpawnAttachment", 5)
local eggCrateAttachment = terrain and terrain:WaitForChild("EggCrateSpawnAttachment", 5)

-- ==========================================
-- TAB SETUP
-- ==========================================
local AutomationTab = Window:CreateTab("Automation", 0) 
AutomationTab:CreateSection("Battery Settings")

AutomationTab:CreateToggle({
    Name = "Auto Grab & Use Battery",
    CurrentValue = false,
    Flag = "MainFarmToggleFlag",
    Callback = function(Value)
        _G.AutoFarm = Value
        if Value then
            task.spawn(function()
                while _G.AutoFarm do
                    if grabBatteryRemote and batteryAttachment then
                        grabBatteryRemote:FireServer(batteryAttachment)
                    end
                    task.wait(_G.FarmDelay)
                    if useBatteryRemote and eggCrateAttachment then
                        useBatteryRemote:FireServer(eggCrateAttachment)
                    end
                    task.wait(_G.FarmDelay)
                end
            end)
        end
    end,
})

AutomationTab:CreateSlider({
    Name = "Farm Speed Delay",
    Range = {0.1, 2},
    Increment = 0.1,
    Suffix = "s",
    CurrentValue = 0.3,
    Flag = "DelaySettingSlider",
    Callback = function(Value)
        _G.FarmDelay = Value
    end,
})

local TeleportTab = Window:CreateTab("Teleports", 0)
TeleportTab:CreateSection("Movement")

TeleportTab:CreateToggle({
    Name = "Auto Teleport to Crate Loop",
    CurrentValue = false,
    Flag = "TPLoopToggle",
    Callback = function(Value)
        _G.AutoTeleport = Value
        if Value then
            task.spawn(function()
                while _G.AutoTeleport do
                    local character = localPlayer.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    if hrp and eggCrateAttachment then
                        hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
                    end
                    task.wait(1)
                end
            end)
        end
    end,
})

TeleportTab:CreateButton({
    Name = "Teleport to Crate (Once)",
    Callback = function()
        local character = localPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp and eggCrateAttachment then
            hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
        end
    end,
})
