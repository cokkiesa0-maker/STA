local success, err = pcall(function()
    -- Rayfield UI Library
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    
    -- Window Configuration
    local Window = Rayfield:CreateWindow({
        Name = "Battery Automation Hub",
        Icon = 0,
        LoadingTitle = "Loading Automation...",
        LoadingSubtitle = "Please wait",
        Theme = "Default",
        DisableRayfieldPrompts = false,
        DisableBuildWarnings = false,
        ConfigurationSaving = {
            Enabled = false,
            FolderName = nil,
            FileName = "WorkspaceConfig"
        },
        Discord = {
            Enabled = false,
            Invite = "noinvitelink",
            RememberJoins = true
        },
        KeySystem = false
    })
    
    -- Global Loop Variables
    local _G = _G or {}
    _G.AutoFarm = false
    _G.AutoTeleport = false
    _G.FarmDelay = 0.3
    
    -- Game Services
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local workspace = game:GetService("Workspace")
    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer
    
    -- Get Remotes with Error Handling
    local remotes = replicatedStorage:WaitForChild("Remotes", 5)
    if not remotes then
        warn("[ERROR] Remotes folder not found in ReplicatedStorage")
        return
    end
    
    local grabBatteryRemote = remotes:WaitForChild("GrabBatteryRemote", 5)
    local useBatteryRemote = remotes:WaitForChild("UseBatteryOnCrateRemote", 5)
    
    if not grabBatteryRemote then warn("[ERROR] GrabBatteryRemote not found") end
    if not useBatteryRemote then warn("[ERROR] UseBatteryOnCrateRemote not found") end
    
    -- Get Game Objects with Error Handling
    local terrain = workspace:WaitForChild("Terrain", 5)
    if not terrain then
        warn("[ERROR] Terrain not found in Workspace")
        return
    end
    
    local batteryAttachment = terrain:WaitForChild("BatterySpawnAttachment", 5)
    local eggCrateAttachment = terrain:WaitForChild("EggCrateSpawnAttachment", 5)
    
    if not batteryAttachment then warn("[ERROR] BatterySpawnAttachment not found") end
    if not eggCrateAttachment then warn("[ERROR] EggCrateSpawnAttachment not found") end
    
    -- ==========================================
    -- TAB 1: AUTOMATION
    -- ==========================================
    local AutomationTab = Window:CreateTab("Automation", 0)
    AutomationTab:CreateSection("Battery Settings")
    
    AutomationTab:CreateToggle({
        Name = "Auto Grab & Use Battery",
        CurrentValue = false,
        Flag = "MainFarmToggleFlag",
        Callback = function(Value)
            _G.AutoFarm = Value
            if Value then
                task.spawn(function()
                    while _G.AutoFarm do
                        if grabBatteryRemote and batteryAttachment then
                            grabBatteryRemote:FireServer(batteryAttachment)
                        end
                        task.wait(_G.FarmDelay)
                        
                        if useBatteryRemote and eggCrateAttachment then
                            useBatteryRemote:FireServer(eggCrateAttachment)
                        end
                        task.wait(_G.FarmDelay)
                    end
                end)
            end
        end,
    })
    
    AutomationTab:CreateSlider({
        Name = "Farm Speed Delay",
        Range = {0.1, 2},
        Increment = 0.1,
        Suffix = "s",
        CurrentValue = 0.3,
        Flag = "DelaySettingSlider",
        Callback = function(Value)
            _G.FarmDelay = Value
        end,
    })
    
    -- ==========================================
    -- TAB 2: TELEPORTS
    -- ==========================================
    local TeleportTab = Window:CreateTab("Teleports", 0)
    TeleportTab:CreateSection("Movement")
    
    TeleportTab:CreateToggle({
        Name = "Auto Teleport to Crate Loop",
        CurrentValue = false,
        Flag = "TPLoopToggle",
        Callback = function(Value)
            _G.AutoTeleport = Value
            if Value then
                task.spawn(function()
                    while _G.AutoTeleport do
                        local character = localPlayer.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")
                        if hrp and eggCrateAttachment then
                            hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
                        end
                        task.wait(1)
                    end
                end)
            end
        end,
    })
    
    TeleportTab:CreateSection("Instant Waypoints")
    
    TeleportTab:CreateButton({
        Name = "Teleport to Crate (Once)",
        Callback = function()
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp and eggCrateAttachment then
                hrp.CFrame = CFrame.new(eggCrateAttachment.WorldPosition + Vector3.new(0, 3, 0))
            else
                warn("[ERROR] Cannot teleport: HRP or Crate Attachment missing")
            end
        end,
    })
    
    TeleportTab:CreateButton({
        Name = "Teleport to Battery Spawn (Once)",
        Callback = function()
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp and batteryAttachment then
                hrp.CFrame = CFrame.new(batteryAttachment.WorldPosition + Vector3.new(0, 3, 0))
            else
                warn("[ERROR] Cannot teleport: HRP or Battery Attachment missing")
            end
        end,
    })
    
    -- ==========================================
    -- FINAL STATUS
    -- ==========================================
    local InfoTab = Window:CreateTab("Info", 0)
    InfoTab:CreateSection("Script Status")
    InfoTab:CreateLabel("✅ Script Loaded Successfully")
    InfoTab:CreateLabel("Remotes: " .. (grabBatteryRemote and "✅" or "❌"))
    InfoTab:CreateLabel("Attachments: " .. (batteryAttachment and eggCrateAttachment and "✅" or "❌"))
    
end)

if not success then
    warn("❌ SCRIPT ERROR: " .. tostring(err))
end
