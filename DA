-- Roblox Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player Setup
local player = Players.LocalPlayer
if not player then
    print("[ERROR] Script must be a LocalScript in StarterPlayerScripts/StarterPack!")
    return
end

-- Wait for character to load
print("[INFO] Waiting for character to load...")
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid", 30)
local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 30)

if not humanoid or not humanoidRootPart then
    print("[ERROR] Missing character parts - humanoid:", humanoid, "RootPart:", humanoidRootPart)
    return
end
print("[INFO] Character loaded successfully!")

-- Game Objects (CHECK THESE PATHS MATCH YOUR GAME!)
print("[INFO] Loading game objects...")
local REMOTE_FOLDER = ReplicatedStorage:FindFirstChild("Remotes")
local GRAB_REMOTE = REMOTE_FOLDER and REMOTE_FOLDER:FindFirstChild("GrabBatteryRemote")
local USE_REMOTE = REMOTE_FOLDER and REMOTE_FOLDER:FindFirstChild("UseBatteryOnCrateRemote")
local DROPS_REMOTE = REMOTE_FOLDER and REMOTE_FOLDER:FindFirstChild("BatteryCrateDropsRemote")

local TERRAIN = Workspace:FindFirstChild("Terrain")
local BATTERY_SPAWN = TERRAIN and TERRAIN:FindFirstChild("BatterySpawnAttachment")
local CRATE_SPAWN = TERRAIN and TERRAIN:FindFirstChild("EggCrateSpawnAttachment")
local DROPS_FOLDER = Workspace:FindFirstChild("Drops")

-- Print what's missing
print("[CHECK] Remotes Folder:", REMOTE_FOLDER)
print("[CHECK] Grab Remote:", GRAB_REMOTE)
print("[CHECK] Use Remote:", USE_REMOTE)
print("[CHECK] Drops Remote:", DROPS_REMOTE)
print("[CHECK] Terrain:", TERRAIN)
print("[CHECK] Battery Spawn:", BATTERY_SPAWN)
print("[CHECK] Crate Spawn:", CRATE_SPAWN)
print("[CHECK] Drops Folder:", DROPS_FOLDER)

if not GRAB_REMOTE or not USE_REMOTE or not BATTERY_SPAWN or not CRATE_SPAWN then
    print("[ERROR] Critical objects missing - fix paths above first!")
    return
end

-- Settings (ADJUST THESE IF NEEDED)
local BATTERY_TOOL_NAME = "Battery" -- Change to your battery's name
local TELEPORT_DISTANCE_LIMIT = 3 -- Studs
local LOOP_DELAY = 2

-- State Tracking
local lastTeleportTarget = nil

-- Helper Functions
local function isCharacterValid()
    local valid = character and humanoid.Health > 0 and humanoidRootPart and character.Parent == Workspace
    if not valid then print("[INFO] Character invalid - dead or missing!") end
    return valid
end

local function hasBattery()
    local inCharacter = character:FindFirstChild(BATTERY_TOOL_NAME)
    local inBackpack = player.Backpack:FindFirstChild(BATTERY_TOOL_NAME)
    local hasIt = inCharacter or inBackpack
    print("[INFO] Has battery?", hasIt, "- In character:", inCharacter, "- In backpack:", inBackpack)
    return hasIt
end

local function teleportTo(target)
    if not isCharacterValid() or not target then return end

    local distance = (humanoidRootPart.Position - target.Position).Magnitude
    if target == lastTeleportTarget then
        print("[INFO] Skipping teleport - same target as last time!")
        return
    end
    if distance < TELEPORT_DISTANCE_LIMIT then
        print("[INFO] Skipping teleport - already within", TELEPORT_DISTANCE_LIMIT, "studs!")
        return
    end

    print("[INFO] Teleporting to:", target.Name)
    humanoidRootPart.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0))
    lastTeleportTarget = target
    task.wait(1)
end

local function collectDrops()
    if not DROPS_FOLDER then
        print("[INFO] Drops folder not found!")
        return
    end

    local drops = DROPS_FOLDER:GetChildren()
    if #drops == 0 then
        print("[INFO] No drops to collect!")
        return
    end

    print("[INFO] Collecting", #drops, "drops...")
    for _, drop in ipairs(drops) do
        if not isCharacterValid() then break end
        
        local dropPart = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart")
        if dropPart then
            teleportTo(dropPart)
            firetouchinterest(humanoidRootPart, dropPart, 0)
            firetouchinterest(humanoidRootPart, dropPart, 1)
            task.wait(0.5)
            if drop.Parent then drop:Destroy() end
        end
    end
end

-- Respawn Handler
player.CharacterAdded:Connect(function(newChar)
    print("[INFO] Character respawned - resetting...")
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    humanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
    lastTeleportTarget = nil
    task.wait(2)
end)

-- MAIN LOOP
print("[INFO] Starting main loop...")
while true do
    task.wait(LOOP_DELAY)

    if not isCharacterValid() then continue end

    -- Step 1: Get Battery
    if not hasBattery() then
        print("[INFO] Going to battery spawn...")
        teleportTo(BATTERY_SPAWN)
        print("[INFO] Firing GrabBatteryRemote...")
        GRAB_REMOTE:FireServer(BATTERY_SPAWN)

        -- Wait up to 5 seconds for battery
        local waitTime = 0
        while not hasBattery() and waitTime < 5 do
            task.wait(0.5)
            waitTime += 0.5
        end
    end

    -- Step 2: Use Battery on Crate
    if hasBattery() then
        print("[INFO] Going to crate spawn...")
        teleportTo(CRATE_SPAWN)
        print("[INFO] Firing UseBatteryOnCrateRemote...")
        USE_REMOTE:FireServer(CRATE_SPAWN)
        task.wait(1)

        -- Step 3: Collect Drops
        print("[INFO] Firing BatteryCrateDropsRemote...")
        DROPS_REMOTE:FireServer(Instance.new("Attachment"))
        task.wait(1)
        collectDrops()

        -- Reset after cycle
        lastTeleportTarget = nil
    end
end
