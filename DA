-- Get core services and player references
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Remotes (keep as needed for interactions)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

-- Helper: Check if player is holding battery
local function hasBattery()
    return player.Backpack:FindFirstChild("Battery") or character:FindFirstChild("Battery")
end

-- Helper: Find and return the exact location of the physical Battery object
local function findBatteryLocation()
    -- Search entire workspace for the Battery (adjust search scope if needed, e.g., workspace.Terrain)
    local battery = workspace:FindFirstChildWhichIsA("BasePart", true)
    while battery and battery.Name ~= "Battery" do
        battery = workspace:FindFirstChildWhichIsA("BasePart", true, battery)
    end

    if battery then
        print("Battery found at: X="..battery.Position.X..", Y="..battery.Position.Y..", Z="..battery.Position.Z)
        return battery.CFrame -- Return exact position/rotation
    else
        print("No Battery detected in workspace")
        return nil
    end
end

-- Helper: Find and return the exact location of the active Battery Deposit
local function findDepositLocation()
    -- Search for the Egg Crate that needs a battery
    local crate = workspace:FindFirstChildWhichIsA("BasePart", true)
    while crate and (crate.Name ~= "EggCrate" or crate:GetAttribute("NeedsBattery") ~= true) do
        crate = workspace:FindFirstChildWhichIsA("BasePart", true, crate)
    end

    if crate then
        print("Active Deposit found at: X="..crate.Position.X..", Y="..crate.Position.Y..", Z="..crate.Position.Z)
        return crate.CFrame + Vector3.new(0, 2, 0) -- Add height for player standing space
    else
        print("No active Battery Deposit detected")
        return nil
    end
end

-- Helper: Teleport to detected location
local function teleportTo(targetLocation)
    if targetLocation then
        humanoidRootPart.CFrame = targetLocation
        task.wait(0.75)
    end
end

-- Main loop: Constantly detect locations and act
while true do
    local batteryLoc = findBatteryLocation()
    local depositLoc = findDepositLocation()

    -- Collect battery if not held and location is found
    if not hasBattery() and batteryLoc then
        teleportTo(batteryLoc)
        grabRemote:FireServer(batteryLoc) -- Send location to server if needed
        task.wait(1.5)
    end

    -- Deposit battery if held and location is found
    if hasBattery() and depositLoc then
        teleportTo(depositLoc)
        useRemote:FireServer(depositLoc) -- Send location to server if needed
        task.wait(1.5)
    end

    -- Re-scan every 2 seconds
    task.wait(2)
end
