-- Services
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Player & Character References
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Remote Events
local grabBatteryRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useBatteryRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")

-- Attachment References
local batteryAttachment = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateAttachment = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

-- Configuration
local TELEPORT_OFFSET = Vector3.new(0, 2, 0) -- Prevent getting stuck in ground
local WAIT_AFTER_INTERACT = 2 -- Seconds to wait after each action

-- Function to Teleport Safely
local function teleportTo(targetAttachment)
    if humanoid.Health <= 0 then return end -- Don't act if player is dead
    humanoidRootPart.CFrame = targetAttachment.WorldCFrame + TELEPORT_OFFSET
    wait(1) -- Give time to finish teleporting
end

-- Main Auto-Loop
while wait(WAIT_AFTER_INTERACT) do
    -- Step 1: Teleport to Battery & Grab
    teleportTo(batteryAttachment)
    grabBatteryRemote:FireServer(batteryAttachment) -- No need for unpack with single arg
    
    -- Step 2: Teleport to Crate & Deposit
    teleportTo(crateAttachment)
    useBatteryRemote:FireServer(crateAttachment, batteryAttachment) -- Send both refs if needed
end

