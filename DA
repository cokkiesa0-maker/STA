-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player & Character
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Remotes & Locations
local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateSpawn = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")
local batteryInventoryCheck = player:WaitForChild("Inventory"):WaitForChild("Battery") -- Adjust to your game's setup

-- Track last teleport target to avoid duplicates
local lastTeleportTarget = nil

-- Teleport Function (with duplicate check)
local function teleportTo(target)
    if humanoid.Health <= 0 then return end
    -- Only teleport if target is different from last one
    if target == lastTeleportTarget then return end

    humanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0)
    lastTeleportTarget = target -- Update last target
    task.wait(1)
end

-- Collect Drops Function (also avoids re-teleporting to same drop)
local function collectDrops()
    local drops = Workspace:FindFirstChild("Drops")
    if not drops then return end
    for _, drop in ipairs(drops:GetChildren()) do
        if humanoid.Health > 0 then
            teleportTo(drop) -- Duplicate check applies here too
            task.wait(0.5)
            drop:Destroy()
        end
    end
end

-- Main Loop
while task.wait(3) do
    if humanoid.Health <= 0 then
        character = player.CharacterAdded:Wait()
        humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        humanoid = character:WaitForChild("Humanoid")
        lastTeleportTarget = nil -- Reset last target on respawn
        task.wait(2)
    end

    -- Step 1: Grab battery only if not held and not already at spawn
    if not batteryInventoryCheck.Value then
        teleportTo(batterySpawn) -- Won't teleport if already there
        grabRemote:FireServer(batterySpawn)
        task.wait(1.5)
        
        while not batteryInventoryCheck.Value do
            task.wait(0.2)
        end
    end

    -- Step 2: Go to crate only if holding battery and not already there
    if batteryInventoryCheck.Value then
        teleportTo(crateSpawn) -- Won't teleport if already there
        useRemote:FireServer(crateSpawn)
        task.wait(1)

        -- Step 3: Handle drops
        dropsRemote:FireServer(Instance.new("Attachment"))
        task.wait(1)
        collectDrops()
        
        batteryInventoryCheck.Value = false
        lastTeleportTarget = nil -- Optional: Reset after full cycle
    end
end
