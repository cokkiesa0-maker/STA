-- ORIGINAL SCRIPT FIXED & COMPLETE
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Track last position to avoid duplicate teleports
local lastTeleportPosition = nil

-- Teleport function - only moves if not already there
local function teleportTo(target)
    -- Calculate distance to target
    local distance = (humanoidRootPart.Position - target.Position).Magnitude
    -- Only teleport if more than 3 studs away AND not the same as last time
    if distance > 3 and target.Position ~= lastTeleportPosition then
        humanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0)
        lastTeleportPosition = target.Position
        task.wait(1)
    end
end

-- Check if player has battery (looks for tool in character/backpack)
local function hasBattery()
    local batteryName = "Battery" -- CHANGE THIS TO YOUR BATTERY'S NAME
    return character:FindFirstChild(batteryName) or player.Backpack:FindFirstChild(batteryName)
end

-- Collect drops function
local function collectDrops()
    local dropsFolder = Workspace:FindFirstChild("Drops")
    if not dropsFolder then return end
    for _, drop in ipairs(dropsFolder:GetChildren()) do
        teleportTo(drop)
        task.wait(0.5)
        -- Touch the drop to collect it
        local dropPart = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart")
        if dropPart then
            firetouchinterest(humanoidRootPart, dropPart, 0)
            firetouchinterest(humanoidRootPart, dropPart, 1)
        end
        drop:Destroy()
    end
end

-- Get necessary objects (matches YOUR original paths exactly)
local batterySpawn = Workspace:WaitForChild("Terrain"):WaitForChild("BatterySpawnAttachment")
local crateSpawn = Workspace:WaitForChild("Terrain"):WaitForChild("EggCrateSpawnAttachment")

local grabRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabBatteryRemote")
local useRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseBatteryOnCrateRemote")
local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BatteryCrateDropsRemote")

-- Main loop - GRABS BATTERY FIRST BEFORE MOVING TO DEPOSIT
while true do
    task.wait(2)

    -- Step 1: ONLY go to battery if we DON'T have it yet
    if not hasBattery() then
        teleportTo(batterySpawn)
        grabRemote:FireServer(batterySpawn)
        -- Wait until battery is collected
        while not hasBattery() do
            task.wait(0.3)
        end
    end

    -- Step 2: NOW go to deposit since we have battery
    if hasBattery() then
        teleportTo(crateSpawn)
        useRemote:FireServer(crateSpawn)
        task.wait(1)

        -- Step 3: Get drops
        dropsRemote:FireServer(Instance.new("Attachment"))
        task.wait(1)
        collectDrops()
    end
end
