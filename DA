-- [[ CONFIGURATION ]] --
local INTERACT_DELAY = 0.8 -- Slightly increased to guarantee the game registers the drop/pick up
local DETECT_RADIUS = 15 -- Distance to search around the player for prompts

-- [[ SERVICES ]] --
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

local depositTracker = {}

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    HumanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
end)

-- [[ FORCED TELEPORT ]] --
-- Bypasses TweenService entirely to force movement. If this doesn't move you, the objects aren't being found.
local function hardTeleport(targetCFrame)
    if not HumanoidRootPart then return end
    
    -- Disables velocity briefly to prevent rubberbanding/falling through floor
    HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    
    -- Move character slightly above the target destination
    HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 2, 0)
    task.wait(0.3) 
end

-- [[ AUTO INTERACTION ]] --
local function interact()
    -- Method 1: Look for nearby ProximityPrompts and fire them instantly
    local foundPrompt = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") and (HumanoidRootPart.Position - parent.Position).Magnitude <= DETECT_RADIUS then
                obj:InputHoldBegin()
                task.wait(obj.HoldDuration + 0.1)
                obj:InputHoldEnd()
                foundPrompt = true
                break
            end
        end
    end
    
    -- Method 2: Fallback virtual keypress if no prompt object is detected
    if not foundPrompt then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
    task.wait(INTERACT_DELAY)
end

-- [[ AGGRESSIVE OBJECT FINDER ]] --
local function scanWorkspace()
    local batteries = {}
    local deposits = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            
            -- Detect Batteries
            if string.find(lowerName, "battery") and not string.find(lowerName, "deposit") and not obj:IsDescendantOf(Character) then
                table.insert(batteries, obj)
            
            -- Detect Deposit/UFO Station
            elseif string.find(lowerName, "deposit") or string.find(lowerName, "ufo") or string.find(lowerName, "ship") or string.find(lowerName, "generator") then
                table.insert(deposits, obj)
            end
        end
    end
    return batteries, deposits
end

-- [[ MAIN EXECUTION ]] --
local function run()
    print("[Script Active] Scanning for game objects...")
    
    while true do
        local batteries, deposits = scanWorkspace()
        
        -- Check if player is holding a battery (checking tool or model inside character)
        local holdingBattery = Character:FindFirstChild("Battery") or Character:FindFirstChildOfClass("Tool")
        
        if not holdingBattery and #batteries > 0 then
            -- Target closest or first found battery part
            local targetBattery = batteries[1]
            print("Battery spotted! Forcing teleport to: " .. targetBattery:GetFullName())
            
            hardTeleport(targetBattery.CFrame)
            interact()
            
        elseif #deposits > 0 then
            -- Randomly select a deposit station from found parts
            local targetDeposit = deposits[math.random(1, #deposits)]
            print("Deposit station spotted! Forcing teleport to: " .. targetDeposit:GetFullName())
            
            hardTeleport(targetDeposit.CFrame)
            interact()
            
            -- Tracker Logic
            if not depositTracker[targetDeposit] then
                depositTracker[targetDeposit] = 0
            end
            depositTracker[targetDeposit] = depositTracker[targetDeposit] + 1
            
            if depositTracker[targetDeposit] >= 2 then
                local randomDelay = math.random(3, 5)
                print("Successfully deposited 2 batteries here! Pausing script for " .. randomDelay .. " seconds.")
                task.wait(randomDelay)
                depositTracker[targetDeposit] = 0 -- Reset
            end
        else
            print("Searching... active objects could not be identified in the Workspace structure.")
        end
        
        task.wait(1.5)
    end
end

pcall(run)
