-- Configuration
local _G = getgenv and getgenv() or _G
_G.AutoWaterToggle = not _G.AutoWaterToggle -- Toggles true/false each time you run it

-- Define the crop data paths
local farmablePlants = game:GetService("Players").LocalPlayer:WaitForChild("Data"):WaitForChild("FarmablePlants")
local waterRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("WaterPlantRemote")

-- Array of plant instances to water
local plantArgs = {
    farmablePlants:WaitForChild("79"),
    farmablePlants:WaitForChild("88"),
    farmablePlants:WaitForChild("78"),
    farmablePlants:WaitForChild("89"),
    farmablePlants:WaitForChild("68")
}

-- Notification helper
local function notify(status)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Auto Water",
        Text = status,
        Duration = 2
    })
end

-- Main Loop Logic
if _G.AutoWaterToggle then
    notify("Enabled")
    
    task.spawn(function()
        while _G.AutoWaterToggle do
            -- Safely invoke the server with the unpacked plant list
            pcall(function()
                waterRemote:InvokeServer(unpack(plantArgs))
            end)
            
            -- Adjust the wait time (in seconds) to prevent rate-limiting/lag
            task.wait(1) 
        end
    end)
else
    notify("Disabled")
end
