-- Configuration & Core Variables
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local localPlayer = Players.LocalPlayer
local _G = getgenv and getgenv() or _G
_G.AutoWaterActive = false

-- Clean existing UI if re-executed
local oldGui = CoreGui:FindFirstChild("AutoWaterUI")
if oldGui then oldGui:Destroy() end

-- Create Mobile UI Button
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoWaterUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local mainButton = Instance.new("TextButton")
mainButton.Size = UDim2.new(0, 120, 0, 45)
mainButton.Position = UDim2.new(0.1, 0, 0.4, 0)
mainButton.BackgroundColor3 = Color3.fromRGB(240, 70, 70) -- Red (Off)
mainButton.Text = "Water: OFF"
mainButton.TextColor3 = Color3.fromRGB(255, 255, 255)
mainButton.Font = Enum.Font.SourceSansBold
mainButton.TextSize = 16
mainButton.Active = true
mainButton.Draggable = true -- Drag anywhere on mobile
mainButton.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = mainButton

-- Visual transition helper
local function tweenColor(targetColor)
    TweenService:Create(mainButton, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
end

-- Function to find and fire Proximity Prompts
local function triggerCropPrompts()
    -- Look through Workspace or Player Data for prompts related to your crops
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            -- Verifies the prompt is related to watering or crops based on common naming conventions
            local nameLower = desc.Name:lower()
            local objectLower = desc.ObjectText:lower()
            local actionLower = desc.ActionText:lower()
            
            if nameLower:find("water") or objectLower:find("plant") or actionLower:find("water") or nameLower:find("crop") then
                -- Direct proximity simulation
                task.spawn(function()
                    desc:InputHoldBegin()
                    task.wait(desc.HoldDuration + 0.05) -- Dynamically scales to the crop's required hold time
                    desc:InputHoldEnd()
                end)
            end
        end
    end
end

-- Main Automation Loop
local function startLoop()
    task.spawn(function()
        while _G.AutoWaterActive do
            pcall(triggerCropPrompts)
            task.wait(0.3) -- Fast polling interval
        end
    end)
end

-- Mobile Interaction Setup
mainButton.MouseButton1Click:Connect(function()
    _G.AutoWaterActive = not _G.AutoWaterActive
    
    if _G.AutoWaterActive then
        mainButton.Text = "Water: ON"
        tweenColor(Color3.fromRGB(70, 240, 120)) -- Green
        startLoop()
    else
        mainButton.Text = "Water: OFF"
        tweenColor(Color3.fromRGB(240, 70, 70)) -- Red
    end
end)
