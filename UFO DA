-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Player & Core References
local player = Players.LocalPlayer
local farmablePlantsFolder = player:WaitForChild("Data"):WaitForChild("FarmablePlants")
local waterRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WaterPlantRemote")

-- Tracked Plant IDs (matches your original list)
local TARGET_PLANTS = {8, 9, 10}

-- Configuration
local CHECK_FREQUENCY = 2 -- How often to check plant status (seconds)
local MIN_WATER_LEVEL = 40 -- Threshold for when plants need water (adjust as needed)

-- Main Detection Function
local function getDryPlants()
    local dryPlants = {}
    
    -- Check each target plant
    for _, plantId in ipairs(TARGET_PLANTS) do
        local plantData = farmablePlantsFolder:FindFirstChild(tostring(plantId))
        if not plantData then continue end -- Skip if plant data missing

        -- Detect if plant needs water (adjust logic to match YOUR game's setup!)
        local needsWater = false
        if plantData:FindFirstChild("NeedsWater") then
            -- Case 1: Game uses a boolean flag
            needsWater = plantData.NeedsWater.Value
        elseif plantData:FindFirstChild("WaterLevel") then
            -- Case 2: Game uses a numeric water level
            needsWater = plantData.WaterLevel.Value < MIN_WATER_LEVEL
        elseif plantData:FindFirstChild("GrowthStage") then
            -- Case 3: Game uses growth stage (optional fallback)
            needsWater = plantData.GrowthStage.Value > 0 -- Only water growing plants
        end

        -- Add to list if dry
        if needsWater then
            table.insert(dryPlants, plantData)
        end
    end

    return dryPlants
end

-- Interaction Function
local function waterDryPlants()
    local dryPlants = getDryPlants()
    
    -- Only trigger remote if there are dry plants
    if #dryPlants > 0 then
        print(string.format("Detected %d dry plant(s) - watering now!", #dryPlants))
        -- Match the original argument structure exactly
        local args = {dryPlants}
        waterRemote:InvokeServer(unpack(args))
    else
        print("All tracked plants are watered - no action needed.")
    end
end

-- Initial Check & Loop
print("Plant water detection system active!")
-- First check immediately when script loads
waterDryPlants()

-- Continuous monitoring loop
local checkConnection = RunService.Heartbeat:Connect(function()
    task.wait(CHECK_FREQUENCY)
    waterDryPlants()
end)

-- Safety cleanup (stops checks if script is destroyed)
script.Destroying:Connect(function()
    if checkConnection then
        checkConnection:Disconnect()
    end
    print("Plant water detection stopped.")
end)
