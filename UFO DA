-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Player & Data References
local player = Players.LocalPlayer
local farmablePlants = player:WaitForChild("Data"):WaitForChild("FarmablePlants")
local waterRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WaterPlantRemote")

-- Configuration
local PLANT_IDS = {8, 9, 10} -- Plants to water
local CHECK_INTERVAL = 3 -- Seconds between checks
local WATER_DELAY = 1 -- Seconds between watering actions
local BUTTON_SIZE = UDim2.new(0, 120, 0, 50)
local BUTTON_POSITION = UDim2.new(0.05, 0, 0.8, 0) -- Bottom-left corner

-- State Tracking
local isAutoWaterEnabled = false
local toggleConnection = nil

-- Create Mobile Toggle Button
local function createToggleButton()
    -- ScreenGui container
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "AutoWaterGui"
    screenGui.Parent = player.PlayerGui

    -- Main Button
    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "ToggleAutoWater"
    toggleButton.Size = BUTTON_SIZE
    toggleButton.Position = BUTTON_POSITION
    toggleButton.BackgroundColor3 = Color3.new(1, 0.2, 0.2) -- Red when off
    toggleButton.TextColor3 = Color3.new(1, 1, 1)
    toggleButton.Text = "Auto-Water: OFF"
    toggleButton.Font = Enum.Font.SourceSansBold
    toggleButton.TextScaled = true
    toggleButton.Parent = screenGui

    -- Add touch/mouse support
    toggleButton.MouseButton1Click:Connect(function()
        isAutoWaterEnabled = not isAutoWaterEnabled
        -- Update button appearance
        if isAutoWaterEnabled then
            toggleButton.BackgroundColor3 = Color3.new(0.2, 1, 0.2) -- Green when on
            toggleButton.Text = "Auto-Water: ON"
            print("Auto-water enabled!")
            startAutoWaterLoop()
        else
            toggleButton.BackgroundColor3 = Color3.new(1, 0.2, 0.2) -- Red when off
            toggleButton.Text = "Auto-Water: OFF"
            print("Auto-water disabled!")
            stopAutoWaterLoop()
        end
    end)

    -- Make button visible only on mobile
    local function updateButtonVisibility()
        toggleButton.Visible = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    end
    updateButtonVisibility()
    UserInputService.TouchEnabledChanged:Connect(updateButtonVisibility)
    UserInputService.MouseEnabledChanged:Connect(updateButtonVisibility)

    return toggleButton
end

-- Helper: Check if a plant needs water
local function plantNeedsWater(plant)
    if plant:FindFirstChild("NeedsWater") then
        return plant.NeedsWater.Value
    elseif plant:FindFirstChild("WaterLevel") then
        return plant.WaterLevel.Value < 50
    end
    return true -- Fallback
end

-- Helper: Water selected plants
local function waterPlants()
    local plantsToWater = {}
    for _, id in ipairs(PLANT_IDS) do
        local plant = farmablePlants:FindFirstChild(tostring(id))
        if plant and plantNeedsWater(plant) then
            table.insert(plantsToWater, plant)
        end
    end

    if #plantsToWater > 0 then
        print("Watering " .. #plantsToWater .. " plants...")
        waterRemote:InvokeServer({unpack(plantsToWater)})
        task.wait(WATER_DELAY)
    end
end

-- Auto-Water Loop Functions
function startAutoWaterLoop()
    -- Stop existing loop if running
    if toggleConnection then
        toggleConnection:Disconnect()
    end
    -- Start new loop
    toggleConnection = RunService.Heartbeat:Connect(function()
        task.wait(CHECK_INTERVAL)
        if isAutoWaterEnabled and farmablePlants and waterRemote then
            waterPlants()
        end
    end)
end

function stopAutoWaterLoop()
    if toggleConnection then
        toggleConnection:Disconnect()
        toggleConnection = nil
    end
end

-- Initialize
print("Auto-water system loaded - tap the button to enable!")
createToggleButton()
