-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- Remotes
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GrabBatteryRemote = Remotes:WaitForChild("GrabBatteryRemote")
local UseBatteryRemote = Remotes:WaitForChild("UseBatteryOnPowerCellRemote")

-- Global toggle
_G.AutoBattery = true

-- Function to safely find objects anywhere in the workspace
local function findObject(name)
    return Workspace:FindFirstChild(name, true)
end

-- Function to safely teleport the player
local function teleportTo(targetInstance)
    if not targetInstance then return false end
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 2)
    
    if rootPart then
        local targetCFrame = targetInstance:IsA("Attachment") and targetInstance.WorldCFrame or targetInstance.CFrame
        rootPart.CFrame = targetCFrame * CFrame.new(0, 2, 0)
        task.wait(0.2)
        return true
    end
    return false
end

-- Main Automation Loop
task.spawn(function()
    print("[Auto] Absolute Path Script Started!")
    
    while _G.AutoBattery do
        -- Dynamically locate targets anywhere in the game world
        local battery = findObject("BatterySpawnAttachment")
        local deposit = findObject("ShipPowerCellAttachment")
        
        -- 1. Grab Battery
        if battery then
            print("[Auto] Moving to Battery...")
            if teleportTo(battery) then
                GrabBatteryRemote:FireServer(battery)
                task.wait(0.5)
            end
        else
            warn("[Auto] BatterySpawnAttachment not found anywhere in Workspace!")
        end
        
        -- 2. Deposit Battery
        if deposit then
            print("[Auto] Moving to Deposit...")
            if teleportTo(deposit) then
                UseBatteryRemote:FireServer(deposit)
                task.wait(1)
            end
        else
            warn("[Auto] ShipPowerCellAttachment not found anywhere in Workspace!")
        end
        
        task.wait(0.5)
    end
    print("[Auto] Script Stopped.")
end)
